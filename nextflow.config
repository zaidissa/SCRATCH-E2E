/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SCRATCH-E2E — end-to-end single-cell tumour analysis pipeline
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Merges eight previously standalone SCRATCH pipelines into one DAG:

      ALIGN -> QC -> CLUSTER -> ANNOTATION -> CNV -> STRATIFY
                                                        |
                            malignant ------------------+-> METAPROG
                                                        |
                        non-malignant ------------------+-> BATCHCORRECT -+-> TRAJECTORY
                                                                          +-> CELLCOMM
                                                                          +-> TME
      ALIGN (VDJ) ------------------------------------------------------------> TCR
      ALIGN (BAM) ------------------------------------------------------------> MICROBIOME
      all of the above -------------------------------------------------------> INTEGRATION

    PARAMETER NAMING
    ----------------
    The source pipelines reused the same parameter name for different things:
    `organism` was "Human" in Annotation but "human" in CNV and CellComm;
    `thr_n_features`, `thr_resolution`, `seed`, `project_name`, `outdir`,
    `template`, `page_config` and `input_seurat_object` all collided. Merging
    them into one `params` block without renaming would have silently applied
    one stage's clustering resolution to another stage.

    Every stage-specific parameter is therefore prefixed with its stage
    (`qc_`, `cluster_`, `annot_`, `bc_`, `cnv_`, `metaprog_`, `traj_`, `cc_`,
    `tcr_`). Notebook-facing names are unchanged: conf/modules.config maps the
    namespaced Nextflow parameter onto the original `-P key:value` the .qmd
    expects, so the vendored notebooks did not have to be edited.
----------------------------------------------------------------------------------------
*/

nextflow.enable.dsl        = 2
nextflow.enable.moduleBinaries = true

manifest {
    name            = 'SCRATCH-E2E'
    author          = 'Syed Shujaat Ali Zaidi'
    description     = 'End-to-end single-cell tumour analysis: alignment through cross-stage integration'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}

params {
    // Opt-in scCODA (compositional DA). Off by default: it selects a ~2 GB
    // TensorFlow image. propeller in the TME notebook is the default test.
    run_scoda = false


    /* =====================================================================
       Project identity and output
       ===================================================================== */
    project_name                = 'project'
    outdir                      = "${launchDir}/results"
    publish_mode                = 'copy'          // copy | symlink | link | rellink
    stage_mode                  = 'symlink'       // task input staging; see process{} below

    // AWS Batch (only read by the awsbatch/cirro profiles)
    aws_queue                   = null
    aws_region                  = 'us-east-1'

    // Canonical organism, lowercase. Stages that need a capitalised form
    // ("Human" for scType/Azimuth) derive it via `organism_capitalised` below,
    // so the two spellings can never drift apart again.
    organism                    = 'human'         // human | mouse
    genome                      = 'GRCh38'        // GRCh38 | GRCm39
    seed                        = 1234

    /* =====================================================================
       Stage selection
       ---------------------------------------------------------------------
       Two ways to choose what runs:

         --from / --to     inclusive stage range along the linear backbone
                           align,qc,cluster,annotation,cnv,stratify
                           then the two compartment arms
         --run_<stage>     force a single branch on or off

       Examples:
         --from align --to cluster            alignment through clustering only
         --from annotation                    resume from an existing RDS
         --from stratify                      re-split an annotated object
         --from metaprog --input_tumor_object <malignant>.RDS
       ===================================================================== */
    from                        = 'align'
    to                          = 'end'

    // Run exactly these stages and nothing else. One name or a comma-separated
    // set. Overrides --from/--to entirely; --run_<stage> still wins over it.
    //   --only cnv                 just CNV calling
    //   --only cnv,stratify        those two, nothing else
    only                        = null

    run_align                   = null   // null = decide from --from/--to
    run_qc                      = null
    run_cluster                 = null
    run_annotation              = null
    run_cnv                     = null
    run_stratify                = null
    run_metaprog                = null   // malignant arm
    run_batchcorrect            = null   // non-malignant arm
    run_trajectory              = null
    run_cellcomm                = null
    run_tme                     = null
    run_tcr                     = null
    run_microbiome              = false  // hard off: see docs/MICROBIOME.md (modules absent upstream)

    // null, like the other stages, so the --from/--to range decides. Setting it
    // to `true` here would make it a permanent override and the integration
    // stage would run even for a partial range such as `--to cluster`.
    run_integration             = null

    /* =====================================================================
       Inputs
       ---------------------------------------------------------------------
       Only the ones required by your chosen --from stage need to be set.
       ===================================================================== */
    input_samplesheet           = null   // ALIGN: sample,fastq_1,fastq_2,modality
    input_exp_table             = null   // QC:    per-sample metadata table
    input_gex_matrices_path     = null   // QC:    glob of cellranger outs (skips ALIGN)
    input_seurat_object         = null   // any downstream stage: resume from RDS
    input_vdj_contigs           = null   // TCR:   filtered_contig_annotations.csv glob
    input_bam_path              = null   // MICROBIOME: possorted BAM glob
    input_cell_mask             = "${projectDir}/assets/NO_FILE"       // optional
    input_reference_object      = "${projectDir}/assets/NO_FILE"       // optional (Azimuth)
    input_tcr_sample_sheet      = "${projectDir}/assets/NO_FILE"       // optional

    // Enter either arm directly, without re-running the split.
    input_tumor_object          = null   // METAPROG: malignant compartment
    input_nonmalignant_object   = null   // BATCHCORRECT and downstream

    /* =====================================================================
       ALIGN
       ===================================================================== */
    modality                    = 'GEX'    // GEX | TCR | GEX+TCR
    multi                       = false    // cellranger multi (hashtag demux)
    demux                       = false    // auto-detect samples from I1 index
    demux_n_detect              = 50000
    demux_min_freq              = 0.01
    demux_mismatches            = 1
    igenomes_base               = "${projectDir}/references"

    /* =====================================================================
       QC  (was: SCRATCH-QC-multi-mode `thr_*`)
       ===================================================================== */
    // ON. CellBender removes the diffuse ambient background that contaminates
    // differential expression. On HGSOC HRS371755 it cut the share of
    // non-plasma cells carrying ANY immunoglobulin from 22.5% to 12.3% while
    // leaving real plasma cells alone (Ig fraction 58.8% -> 61.7%).
    //
    // Judge it on DETECTION RATE in cells that should not express the gene, not
    // on total UMI removed: Ig UMI mass sits in real plasma cells, so a global
    // "0.33% of Ig counts removed" looks like failure while the DE-relevant
    // background has halved. Wilcoxon DE and min.pct key on the fraction of
    // cells expressing, which is exactly what this moves.
    skip_cellbender             = false
    // null = derive per sample (cellranger's cell call + the raw UMI curve).
    // A number here overrides the derivation for EVERY sample, which is only
    // correct when every library is the same size.
    cellbender_expected_cells   = null
    cellbender_total_droplets   = null
    cellbender_cuda             = false
    cellbender_fpr              = 0.01
    cellbender_epochs           = 150
    // Samples to analyse WITHOUT CellBender (comma/semicolon list, exact sample
    // names). They use cellranger's filtered matrix and each one's QC report says
    // so. For a library CellBender cannot finish on CPU; empty = none skipped.
    cellbender_skip_samples     = ''

    // Which ambient-RNA method runs: cellbender | decontx.
    //
    // cellbender  a deep generative model over every droplet. The most precise
    //             background estimate in published benchmarks, and the slowest:
    //             ~6 h per library on a CPU queue at 150 epochs, and the 4-lane
    //             GBM libraries ran for four days. `cellbender_cuda` alone does
    //             NOT obtain a GPU — no process here declares an accelerator.
    // decontx     variational EM over the cell matrix (celda). No GPU, no empty
    //             droplets required. The 2026 seven-method benchmark groups it
    //             with CellBender and SoupX and says to choose on the compute
    //             available.
    //
    // --skip_cellbender true still means NO correction at all and outranks this.
    ambient_method              = 'cellbender'  // cellbender | decontx

    // DecontX uses the raw matrix, when there is one, only to sharpen the
    // ambient profile — unlike CellBender it does not require empty droplets.
    decontx_use_background      = true
    decontx_seed                = 12345

    qc_thr_estimate_n_cells     = 300
    qc_thr_mean_reads_per_cells = 25000
    qc_thr_median_genes_per_cell= 900
    qc_thr_median_umi_per_cell  = 1000
    qc_thr_n_feature_rna_min    = 300
    qc_thr_n_feature_rna_max    = 7500
    qc_thr_percent_mito         = 25
    qc_thr_n_observed_cells     = 300

    skip_scdblfinder            = false

    // (`qc_doublet_filter` removed with the BPCells port: the ported notebook
    //  calls doublets per sample only and saves one object, so there is nothing
    //  left to choose between.)

    /* =====================================================================
       CLUSTER  (was: `thr_n_features`, `thr_n_dimensions`, `thr_resolution`,
                       `thr_proportion`, `input_integration_dimension`)
       ===================================================================== */
    cluster_thr_n_features      = 2000
    cluster_thr_n_dimensions    = 100
    cluster_integration_dimension = 'auto'
    cluster_group_plot          = 'patient_id;timepoint'
    cluster_thr_resolution      = 0.5
    cluster_thr_proportion      = 0.25

    /* =====================================================================
       ANNOTATION  (was: `thr_n_features`, `thr_npc`, `thr_resolution`)
       ===================================================================== */
    // scType's marker database. THE reference to change per tumour type: the
    // markers that define a lineage in ovarian are not the ones that define it
    // in glioma, and `parent_level` in this file decides both the major classes
    // and which of them get a second, state-level pass.
    //   parent_level,cell_group,cell_annotation,markers
    //   Lineage_markers,Major_cells,T_Cells,CD3D      <- major pass
    //   T_Cells,CD8,CD8_effector,GZMB                 <- state pass for T_Cells
    //
    // TUMOUR TYPE PRESETS. Four settings describe one thing — which lineages this
    // tumour has, which of them have states worth resolving, which is the tumour
    // lineage, and which are the normal baseline — and setting one without the
    // others gives a run that completes on the wrong vocabulary. --tumor_type
    // picks all four together:
    //   annot_db, annot_state_exclude, stratify_tumor_labels, stratify_reference_labels
    // Each is a lookup on params.tumor_type, so an explicitly supplied value (on
    // the command line or in a params file) still wins over its preset. That has
    // to happen HERE: a params value assigned from inside a script function is
    // silently ignored by Nextflow 26, and config sees CLI/params-file values.
    // Adding a tumour type = one marker CSV in assets/ plus one key in each of the
    // four maps below, and the name in main.nf's check and the Cirro form enum.
    //   ovarian       carcinoma database shipped with the pipeline
    //   glioblastoma  derived from GBmap Core (assets/gbm_cell_markers_database.csv)
    tumor_type                  = 'ovarian'     // ovarian | glioblastoma
    annot_db                    = "${projectDir}/assets/" + [
                                      ovarian:      'cell_markers_database.csv',
                                      glioblastoma: 'gbm_cell_markers_database.csv',
                                  ][params.tumor_type?.toString()?.toLowerCase()]

    // Which annotator the OBJECT handed downstream is built on. Both still run
    // and both are reported; this decides whose labels the CNV, stratification
    // and communication stages actually read.
    //
    // scType by default: its vocabulary comes from annot_db, which you control
    // per tumour type, whereas Azimuth is only as applicable as the reference
    // object you happen to have. Azimuth also silently contributes nothing when
    // --input_reference_object is absent, which made the previous
    // Azimuth-first order depend on whether a file was passed.
    annot_primary               = 'sctype'      // sctype | azimuth

    // Major classes that do NOT get a second, state-level annotation pass —
    // either because they have no meaningful subsets in this build's database,
    // or because they are the tumour compartment and are handled by the
    // metaprogram stage instead. Matched as a regex against the major label.
    //
    // Was hardcoded to the ovarian list: a sarcoma wants Fibroblast states, and a
    // glioma has no Epithelial compartment at all. The glioblastoma list is every
    // major class with a single GBmap sub-population. Preset by --tumor_type.
    annot_state_exclude         = [
                                      ovarian:      'Unknown;Epithelial;Fibroblast;NK_Cells',
                                      glioblastoma: 'Unknown;NK_Cells;B_Cells;Plasma_Cells;Mast;Oligodendrocyte;OPC;Astrocyte;Neuron;Radial_Glia',
                                  ][params.tumor_type?.toString()?.toLowerCase()]
    annot_thr_n_features        = 2000
    annot_thr_npc               = 25
    annot_thr_resolution        = 0.50
    // Default OFF. It has never produced a report in this pipeline: the Jupyter
    // kernel starts, stays alive and never answers its client, so the render dies
    // before executing a cell. Ruled out: the startup timeout, HOME/IPYTHONDIR,
    // uid mapping, the image, ZMQ, ipykernel itself. Prime suspect is
    // jupyter_client under QEMU, which means it may well work on native x86 --
    // so it stays one flag away rather than being removed. Turn it on
    // deliberately (`--skip_celltypist false`), not by inheriting a default that
    // sinks the annotation stage.
    skip_celltypist             = true
    // Seconds nbclient waits for the Jupyter kernel behind notebook_celltypist to
    // come up. Quarto's own default is 60, which is not enough under QEMU
    // emulation when other heavyweight containers are running (see the module).
    // Which pre-trained CellTypist model to annotate against. The notebook used
    // to hardcode Immune_All_Low, which is an IMMUNE-ONLY model: on a tumour
    // dataset it has no vocabulary for epithelial or stromal cells and will
    // confidently label them as immune subtypes. That is the wrong default for
    // this pipeline, but the right model depends on the tissue, so it is a
    // parameter rather than a new hardcoded guess.
    //
    // Any model name from `celltypist.models.models_description()` works, e.g.
    // Immune_All_Low.pkl, Immune_All_High.pkl, Human_Lung_Atlas.pkl,
    // Adult_Human_PancreaticIslet.pkl, Developing_Human_Brain.pkl.
    annot_celltypist_model      = 'Immune_All_Low.pkl'
    // Re-download the model even when a cached copy exists. Leave false unless
    // the bundled model is stale or corrupt.
    annot_celltypist_update     = false
    celltypist_kernel_timeout   = 600
    skip_sctype                 = false
    skip_azimuth                = false
    skip_annotation_concordance = false
    concordance_min_pair_cells  = 20      // label pairs rarer than this are dropped from the confusion heatmap

    /* =====================================================================
       BATCH CORRECTION
       ===================================================================== */
    skip_batchcorrect           = false
    bc_integration_method       = 'all'      // all | cca | rpca | harmony | mnn
    bc_target_variables         = 'batch'
    bc_batch_step               = 'main'
    // Empty by design. STRATIFY has already removed malignant cells, so the
    // notebook's own `exclude_labels` subsetting would filter a second time on
    // a lineage proxy. Set it only if you bypass STRATIFY.
    bc_exclude_labels           = ''
    bc_celltype_column          = 'celltype'
    // 'sctype' / 'sctype_agg' are what THIS pipeline's own annotation stage
    // writes. Their absence here is the same blind spot that made STRATIFY
    // silently drop its labels: batch correction stopped with "could not find
    // any label column" on the pipeline's own output. Any stage that resolves an
    // annotation column must list them.
    bc_label_candidates         = 'sctype;sctype_agg;azimuth_labels;celltype;cell_type;annotation;cell_label;celllabel'
    // Fraction of cells the integration EVALUATION runs on, stratified by batch
    // and label. Metrics only: four integrations x clustering x kBET over a full
    // cohort is expensive. It does NOT affect the published object — it used to,
    // which silently handed 30% of the microenvironment to trajectory, cell
    // communication and TME. Set to 1 to evaluate on every cell.
    bc_eval_cell_proportion     = 0.30
    bc_n_hvgs                   = 3000
    bc_n_pcs                    = 50

    /* =====================================================================
       CNV
       ===================================================================== */
    skip_infercnv               = false
    skip_cnv_concordance        = false
    skip_copykat                = true
    cnv_analysis_mode           = 'samples'
    // 0 disables inferCNV's Bayesian mixture filter, which crashes in its own
    // MCMC code when a cell group yields no draws. See the notebook's
    // `infer_cnv_run part 2` chunk. inferCNV's own default is 0.5.
    cnv_infercnv_bayes_max_p_normal = 0
    // Cap on cells per reference/observation group handed to inferCNV.
    // 0 = no cap, which is the default and the previous behaviour.
    //
    // inferCNV's cost is dominated by `cluster_by_groups = TRUE`, which runs a
    // hierarchical clustering WITHIN each group; hclust needs the full pairwise
    // distance matrix, so the work is quadratic in group size and runs on one
    // core. On this GBM cohort (~60k post-QC cells, one large Malignant group)
    // a single attempt took 5-12 h. Capping the biggest group at a few thousand
    // cells cuts that group's clustering cost by the square of the ratio.
    //
    // This is OFF by default because it changes WHAT YOU GET, not just how long
    // it takes: only the sampled cells receive an inferCNV score, so cells left
    // out carry no inferCNV evidence into CNV_CONCORDANCE or STRATIFY. That is
    // defensible when Numbat is the primary caller (--cnv_caller_priority) and
    // inferCNV is the cross-check, and it is not something to switch on silently
    // -- hence a parameter rather than a new default.
    cnv_infercnv_max_cells_per_group = 0
    // Which caller's per-cell call wins when the two disagree. Numbat by
    // default: it is allele-aware, so it sees copy-neutral LOH that inferCNV
    // cannot, and its call does not depend on a reference lineage being named
    // correctly to build a null. Set to 'infercnv' to invert the preference.
    // (Replaces the old boolean `stratify_numbat_priority`, whose name presumed
    //  the answer and could not express the other choice.)
    cnv_caller_priority         = 'numbat'   // numbat | infercnv

    /* =====================================================================
       NUMBAT — allele-aware CNV calling (opt-in)
       ---------------------------------------------------------------------
       Off by default: unlike the other three callers it needs the aligned BAM
       plus a phasing reference panel, which are large external downloads.

       What it adds: inferCNV, SCEVAN and CopyKAT infer copy number from
       expression smoothed along the genome, so they cannot see copy-neutral
       LOH — allele ratios change, dosage does not. Numbat reads phased
       heterozygous SNPs from the BAM and does.

       Enabling it also makes --stratify_min_callers 2 meaningful, since the
       consensus then has four independent opinions rather than two.

       See docs/NUMBAT.md for obtaining the reference files.
       ===================================================================== */
    // ON by default. Numbat is allele-aware: it phases reads at heterozygous SNPs
    // rather than smoothing expression along the genome, so it sees copy-neutral
    // LOH that inferCNV/SCEVAN/CopyKAT are blind to, and it does not depend on a
    // reference lineage being correctly named to build its null — the failure mode
    // that let a fibroblast-only null set inferCNV's cutoff to 0 and call whole
    // immune lineages malignant.
    //
    // The cost is real and worth knowing before it surprises you: it needs the
    // aligned BAM (~80 GB/sample here) plus a phasing panel, and on this machine
    // the pileup dominates — measured 3 h/run against inferCNV's 44 min. It is the
    // better CALLER, not the cheaper one.
    //
    // Runs with no BAM are not an error: main.nf switches it off with a warning,
    // the same way TCR is skipped when there is no VDJ input.
    run_numbat                  = true

    // When the three refs below are all null and numbat_fetch_refs is true,
    // NUMBAT_FETCH_REFS downloads them ONCE into numbat_refs_dir (~10 GB) via
    // storeDir, so it never repeats across runs or after work/ is cleaned.
    // FALSE by default: pkharchenkolab/numbat-rbase already contains all three
    // references, so there is nothing to download. Set true only when running a
    // different image that lacks them -- and note the upstream panel host is
    // behind a WAF that breaks automated download.
    numbat_fetch_refs           = false
    numbat_refs_dir             = "${projectDir}/assets/numbat_refs"
    numbat_gmap                 = null   // Eagle2 genetic map (.txt.gz)
    numbat_snpvcf               = null   // 1000G SNP VCF for the genome build
    numbat_paneldir             = null   // 1000G phasing panel directory

    numbat_genome               = 'hg38' // must match --genome
    numbat_sample_col           = 'sample_id'
    // The unit Numbat RUNS on: the individual, not the library.
    //
    // numbat:::mark_tumor_lineage() assigns the tumour compartment as
    //     tumor_root  = mut_nodes[which.max(mut_burdens)]
    //     compartment = ifelse(seq > 0, "tumor", "normal")
    // -- no significance test, no null. Whatever segments survive min_LLR go on
    // a tree and the heaviest clade becomes "tumor", so Numbat cannot report
    // "there is no tumour in this sample". Run per library, a PBMC or matched
    // normal library therefore returns its own noise partitioned into tumour
    // and normal rather than returning nothing, which is exactly what was
    // observed on GBM-DFCI3: neoplastic calls in libraries that should be ~0%.
    //
    // Pooled across the individual's libraries the real aneuploid clones
    // dominate the mutation burden, tumor_root lands on the genuine tumour
    // clade, and the normal cells stay normal. It is also what Numbat itself
    // documents -- pileup_and_phase.R: "--samples ... All samples must belong
    // to the same individual" -- and the joint genotyping gives every
    // heterozygous site coverage from every library the individual contributed.
    //
    // Falls back through patient/subject/donor and finally to the library
    // column, which reproduces the old per-library behaviour. That fallback is
    // reported as a WARNING in both the task log and the run console, because
    // it is the configuration this parameter exists to avoid.
    numbat_group_col            = 'patient_id'
    // Cells needed before an individual gets an expression reference built from
    // their OWN immune and stromal cells instead of numbat::ref_hca (12 generic
    // profiles from another study, whose gap from the real cohort is read as
    // expression CNV signal). A normal library makes this reachable; per
    // library there were often no normal cells to build it from.
    // RAISED 50 -> 100 together with the per-column floor below: a column can
    // never be larger than the total, so a total floor under the per-column
    // floor could only ever mean "one valid column is enough". The script
    // raises it and says so if the two are set inconsistently.
    numbat_min_ref_cells        = 100

    // ---- what a reference COLUMN is -------------------------------------
    // lambdas_ref is a gene x pseudobulk matrix and Numbat picks the
    // best-fitting COLUMN per pseudobulk; the names are for us, not for it
    // ("columns are pseudobulk names", run_numbat docs). Numbat's own worked
    // example builds the reference from raw unsupervised clusters with no
    // annotation at all (vignettes/mouse.Rmd section 4):
    //
    //     clusters  = p2$clusters$PCA$multilevel
    //     ref_annot = data.frame(cell = names(clusters), group = unname(clusters))
    //     ref       = aggregate_counts(count_mat_ref,
    //                     ref_annot %>% group_by(group) %>% filter(n() > 100))
    //
    // What a column needs is transcriptional homogeneity and enough cells, not
    // a biological name. scType assigns ONE label per cluster, so aggregating
    // by label collapses several clusters into one averaged column and discards
    // resolution the clustering already produced. Grouping by
    // <label>__c<cluster> keeps the SAME eligibility rule
    // (stratify_reference_labels) and gives Numbat finer columns to match.
    numbat_cluster_col              = 'seurat_clusters'
    // Per-COLUMN cell floor, and the author's number in the example above. At
    // label granularity a floor never fires (every label has hundreds of
    // cells); at cluster granularity it is the actual quality control.
    numbat_ref_min_group_cells      = 100
    // Clusters admitted to the reference REGARDLESS of their label. Empty by
    // default and deliberately so.
    //
    // Numbat's maintainer gives two rules that conflict in glioma: "no
    // tumor/malignant cells" may enter the diploid reference, and the reference
    // should "include the relevant normal cell types present in your sample"
    // (kharchenkolab/numbat#224). GBM tissue contains normal astrocytes, OPCs
    // and neurons -- but the Neftel malignant states carry exactly those
    // labels, so stratify_reference_labels cannot admit them without admitting
    // tumour. No label-based rule can separate the two.
    //
    // A CLUSTER can be judged individually, with evidence from outside the
    // annotation (a flat inferCNV profile, say). That judgement is the user's,
    // which is why this is an explicit opt-in and never a default: deciding it
    // from the annotation alone would be circular. Comma-separated cluster ids,
    // matched against numbat_cluster_col.
    numbat_extra_reference_clusters = ''

    numbat_min_cells            = 50     // per sample, below this it is skipped
    numbat_t                    = 1e-5   // transition probability
    numbat_max_iter             = 2      // phylogeny refinement iterations
    // Log-likelihood-ratio floor for keeping a CNV. Numbat's default is 5; on a
    // sample where every CNV is filtered out it prints "Consider reducing
    // min_LLR", so this needs to be reachable to act on that.
    numbat_min_llr              = 5
    // Single-cell entropy ceiling for keeping a CNV on the phylogeny. Numbat's
    // maintainer names max_entropy and min_LLR as the two levers for "a tumor
    // proportion much higher than orthogonal measurements suggest" -- CNV false
    // positives in normal cells (kharchenkolab/numbat#224). Lowering this is
    // stricter.
    //
    // Set to Numbat's OWN default, so exposing it changes nothing. min_llr also
    // stays at Numbat's 5: both are now reachable, and neither has been
    // calibrated on this cohort. Turning either dial changes the sensitivity of
    // every call on every sample, so it should follow a measurement rather than
    // precede one.
    numbat_max_entropy          = 0.5

    // ---- Numbat's own figures (NUMBAT_REPORT) ----------------------------
    // run_numbat() is called with plot = FALSE, so until now the pipeline drew
    // none of Numbat's figures: the CNV report carried one Numbat plot, and
    // the concordance notebook built that one itself from segs_consensus.
    // NUMBAT_REPORT redraws the full set from the finished output directory --
    // phylogeny heatmap, clone tree, mutation history, consensus segments,
    // pseudobulk allele profiles, rolling expression.
    //
    // It is a separate task from NUMBAT_RUN because the task hash covers the
    // process script: putting the plotting inside NUMBAT_RUN re-runs the model
    // fit for every sample (957 CPU-hours for 15 GBM libraries) to redraw
    // pictures from numbers already on disk. Setting plot = TRUE would do the
    // same AND produce only five of the figures.
    skip_numbat_figures            = false
    // Clone counts to re-cut the phylogeny at, drawn side by side. Numbat's
    // clone count is a CHOICE, not a measurement, and this is the figure that
    // shows what it costs. 0 skips that one panel; the rest are unaffected.
    numbat_figures_ncut            = 4
    // A clone smaller than this is left out of the pseudobulk profile figure:
    // its allele track is too sparse to read.
    numbat_figures_min_clone_cells = 50
    // LLR floor for drawing a CNV on the pseudobulk profiles. Higher than
    // numbat_min_llr on purpose -- this filters what is PLOTTED, not what was
    // called, and the figure becomes unreadable long before the call does.
    numbat_figures_min_llr         = 10

    /* =====================================================================
       STRATIFY — malignant / non-malignant split
       ---------------------------------------------------------------------
       Runs after CNV calling and decides which compartment each cell belongs
       to. CNV evidence is primary because aneuploidy is a direct measurement of
       malignancy; an annotation label such as "Epithelial" is a lineage proxy
       that would call normal epithelium a tumour.

         consensus   CNV callers decide; the annotation label breaks ties and
                     covers cells no caller scored               (default)
         cnv         CNV callers only; unscored cells are ambiguous
         annotation  labels only (use when no CNV caller ran)
       ===================================================================== */
    stratify_method             = 'consensus'   // consensus | cnv | annotation
    stratify_min_callers        = 1             // callers that must agree
    // Annotation labels treated as the tumour lineage. Preset by --tumor_type:
    // carcinoma cells are Epithelial; the glioblastoma database collapses the four
    // Neftel states into one Malignant class.
    stratify_tumor_labels       = [
                                      ovarian:      'Epithelial',
                                      glioblastoma: 'Malignant',
                                  ][params.tumor_type?.toString()?.toLowerCase()]
    // The normal baseline for inferCNV, stratification and CNV concordance. MUST
    // match the major labels the active annot_db emits: names that match nothing
    // silently shrink the inferCNV null. Preset by --tumor_type, so it changes
    // together with the database it has to agree with.
    //
    // The glioblastoma list was written by analogy to the ovarian one and lost
    // coverage in the process: the ovarian database has ONE coarse `Myeloid`
    // class and one `B_Plasma_Cells` class, while the glioblastoma database
    // splits the same lineages into Monocyte, Dendritic_Cells, Mast, B_Cells
    // and Plasma_Cells, plus Mural_Cells for the perivascular compartment. The
    // matcher expands a coarse lineage to finer labels but cannot invent the
    // request, so those six matched NOTHING. Measured in the real image on a
    // 1,000-cell stand-in, consensus + gate_by_lineage with no CNV verdict:
    // 6 of 18 database labels matched, and 400 cells — every Monocyte,
    // Dendritic_Cells, Astrocyte and Unknown cell — fell through to
    // `annotation_call = NA` and were EXCLUDED from both compartments. Nothing
    // errors; the myeloid compartment simply goes missing from the
    // non-malignant object that batch correction, TME and trajectory run on,
    // and those lineages also lose the gate that keeps a stray CNV call from
    // putting a B cell in the tumour compartment.
    //
    // Astrocyte, OPC, Radial_Glia, Neuron and Unknown are deliberately NOT
    // here: in glioma the Neftel AC-like, OPC-like and NPC-like malignant
    // states carry exactly those labels, so gating them non-malignant would
    // discard real tumour cells. They are left to the CNV evidence, which is
    // the behaviour `stratify_gate_by_lineage` documents.
    stratify_reference_labels   = [
                                      ovarian:      'T_Cells;NK_Cells;Myeloid;B_Plasma_Cells;Endothelial_Cells;Fibroblast',
                                      glioblastoma: 'TAM_Microglial;TAM_BloodDerived;Monocyte;Dendritic_Cells;Mast;T_Cells;NK_Cells;B_Cells;Plasma_Cells;Oligodendrocyte;Endothelial_Cells;Mural_Cells',
                                  ][params.tumor_type?.toString()?.toLowerCase()]
    // Numbat measures the allelic channel directly, which the expression-based
    // callers cannot see at all. Where it has a verdict it decides, rather than
    // casting one equal vote. The lineage gate still overrides it.
    // (moved to `cnv_caller_priority` in the CNV block: the choice belongs with
    //  the callers, and it is now a name rather than a boolean.)

    // SDs above the reference-lineage mean. LOWERED 3 -> 2 on 2026-08-20, calibrated
    // against Numbat on HRS371755 (9,227 cells Numbat scored):
    //
    //   k     threshold   called malignant   agreement with Numbat
    //   3.0     2.640            0                 41.3%
    //   2.5     2.307            0                 41.3%
    //   2.0     1.974        4,793                 92.2%
    //   1.5     1.641        4,793                 92.2%   <- best Youden J (0.864)
    //   1.0     1.309        6,775                 83.0%
    //
    // At 3 the threshold sat ABOVE the entire epithelial block, so inferCNV called
    // nothing malignant and the compartment split was Numbat's alone with nothing
    // saying so. 2.0 is the stringent end of the plateau that agrees with Numbat.
    //
    // CAVEAT worth knowing before trusting it elsewhere: this is calibrated on ONE
    // sample. HRS371760 produced no Numbat calls at all, so it contributed nothing
    // to the fit. CNV_CONCORDANCE re-derives the best k on whatever data it is
    // given and reports it as an advisory, so a different cohort will say so.
    stratify_infercnv_sd        = 2
    // Cell type defines the biological compartment; CNV adjudicates malignancy
    // only within it. Immune, stromal and endothelial lineages are non-malignant
    // regardless of their CNV score — otherwise the reference lineages that
    // define the null distribution can themselves be called malignant.
    // Unlabelled and "Unknown" cells are NOT gated: they are left to the CNV
    // evidence, which is what keeps glioma's astrocyte-like cells in play.
    stratify_gate_by_lineage    = true

    stratify_ambiguous          = 'exclude'     // exclude | malignant | non_malignant
    stratify_min_cells          = 50            // per compartment, else skip that arm

    /* =====================================================================
       TUMOUR HETEROGENEITY / METAPROGRAMS
       ---------------------------------------------------------------------
       `metaprog_nmf_engine` selects the factorisation backend:

         'r'      NMF::nmf (snmf/r) as in the original pipeline
         'python' scanpy + scikit-learn NMF (default; substantially faster
                  over the same rank sweep, and emits basis matrices in the
                  identical gene x program layout PostNMF consumes)
         'both'   run both and cross-check concordance in the report

       See docs/NMF_ENGINES.md for the equivalence argument and benchmarks.
       ===================================================================== */
    // STRATIFY writes `malignant_status`; subsetting on it is a no-op when the
    // malignant object is supplied and a correct filter when it is not.
    metaprog_subset_col         = 'malignant_status'
    metaprog_subset_values      = 'malignant'
    metaprog_min_cells_per_sample = 150
    metaprog_complexity_filter  = 1000
    metaprog_mito_filter        = 20
    metaprog_hvg_keep           = 7000
    metaprog_dims_use_max       = 50
    metaprog_resolution         = 1.0
    metaprog_genes_per_program  = 50
    metaprog_sig_th             = 0.005

    metaprog_nmf_engine         = 'python'   // python | r | both
    metaprog_rank_lb            = 3
    metaprog_rank_ub            = 5
    metaprog_nrun               = 2
    metaprog_nmf_method         = 'snmf/r'   // R engine only
    metaprog_max_cells          = 0          // 0 = no downsampling
    metaprog_min_cells          = 100

    // Python engine specifics
    metaprog_py_init            = 'nndsvda'  // nndsvd | nndsvda | nndsvdar | random
    metaprog_py_solver          = 'cd'       // cd | mu
    metaprog_py_beta_loss       = 'frobenius'
    metaprog_py_max_iter        = 1000
    metaprog_py_tol             = 1e-4

    // Meta-programme assembly (PostNMF)
    metaprog_mp_num             = 13
    metaprog_mp_min_size        = 4
    metaprog_mp_max_size_frac   = 0.5
    metaprog_min_intersect_initial = 12
    metaprog_min_intersect_cluster = 12
    metaprog_min_group_size     = 4
    metaprog_intra_min          = 25
    metaprog_intra_max          = 12
    metaprog_inter_min          = 8
    metaprog_post_min_n         = 2

    /* =====================================================================
       TRAJECTORY
       ===================================================================== */
    skip_trajectory             = false
    traj_species                = 'human'

    /* =====================================================================
       CELL COMMUNICATION
       ===================================================================== */
    skip_cellcomm               = false
    cc_assay                    = 'RNA'
    cc_slot                     = 'data'
    /* =====================================================================
       GLOBAL COLUMN NAMES
       ---------------------------------------------------------------------
       GIANA, GLIPH2, CONSENSUS_CLUSTERING and CONGA all reference
       params.sample_col / params.condition_col, which were never defined
       anywhere. They interpolated to the literal string "null" and every run
       printed "Access to undefined parameter" — a warning that had been there
       so long it read as noise.

       These are also the single place to set a column name once, instead of
       having to know tme_celltype_col, cc_celltype_col and
       stratify_celltype_col separately. Stage-specific params still win where
       explicitly set.
       ===================================================================== */
    sample_col                  = 'sample_id'
    condition_col               = 'condition'
    celltype_col                = 'sctype'   // what ANNOTATION actually writes

    cc_celltype_col             = null   // null -> use params.celltype_col
    cc_sample_col               = 'sample_id'
    cc_condition_col            = 'condition'
    cc_min_cells_per_group      = 30
    /* ---------------------------------------------------------------
       Cell-communication tools are individually skippable, like every
       other optional component (skip_infercnv, skip_scevan, ...). They
       previously had NO skip parameter and NO ext.when guard, so a tool
       that could not run — NicheNet needs ~320 MB of external reference
       networks that are not shipped — took the whole stage down with it.
       --------------------------------------------------------------- */
    skip_liana                  = false
    skip_cellchat               = false
    skip_nichenet               = false

    cc_liana_resource           = 'consensus'
    cc_liana_top_n_plot         = 300
    cc_receiver_mode            = 'auto'
    cc_sender_mode              = 'auto_top_outgoing'
    cc_auto_k_receivers         = 3
    cc_auto_m_senders           = 5
    cc_manual_receivers         = 'CD8 T'
    cc_manual_senders           = 'Mono,DC,Fibroblast'
    cc_condition_ref            = 'Control'
    cc_condition_test           = 'Case'
    cc_logfc_min                = 0.25
    cc_padj_max                 = 0.05
    cc_max_geneset              = 300
    cc_top_ligands              = 30
    cc_heatmap_ligands          = 15
    cc_heatmap_targets_per_ligand = 40
    nichenet_assets_dir         = "${projectDir}/assets/nichenet_resources"
    // The shipped .rds files are Git LFS pointers. When they are unresolved AND
    // nichenet_assets_dir is still the default, download them (~320 MB, Zenodo)
    // rather than failing at the ninth of eleven stages. Naming a directory
    // explicitly turns this off: a wrong path should error, not silently fetch
    // somewhere else. Set false for an air-gapped run.
    nichenet_fetch_refs         = true
    // NOT ${projectDir}/assets: storeDir would then see the shipped
    // assets/nichenet_resources -- the directory of LFS pointers this fetch
    // exists to replace -- decide the output is already present, and skip the
    // download while handing NicheNet the pointers again. Verified: the stub run
    // reported "[skipping] Stored process > NICHENET_FETCH_REFS".
    nichenet_refs_dir           = "${projectDir}/assets/nichenet_fetched"

    /* =====================================================================
       TME CHARACTERISATION  (non-malignant compartment)
       ===================================================================== */
    skip_tme                    = false
    tme_celltype_col            = null   // null -> use params.celltype_col
    tme_sample_col              = 'sample_id'
    tme_condition_col           = 'condition'
    tme_patient_col             = 'patient_id'
    tme_min_cells_per_group     = 30
    tme_top_n_celltypes         = 12

    /* =====================================================================
       TCR
       ===================================================================== */
    // T cells are non-malignant, so the batch-corrected compartment is usually
    // the better input; 'annotated' keeps the pre-split object.
    tcr_input                   = 'annotated'   // annotated | nonmalignant
    tcr_run_vdj_qc              = true
    tcr_run_tcri                = true
    tcr_run_conga               = true
    tcr_run_gliph2              = true
    tcr_run_tcrdist3            = true
    tcr_run_giana               = true
    tcr_run_repertoire          = true
    tcr_run_consensus           = true
    tcr_run_master_summary      = true
    gliph2_assets_dir           = "${projectDir}/assets/gliph2"

    /* =====================================================================
       CROSS-STAGE INTEGRATION & REPORTING
       ===================================================================== */
    // Per-stage smart reports: summary-first, computed findings, interactive
    // tables and figures, and the offline agent — built from each stage's
    // published outputs.
    stage_reports               = true

    integration_build_master_object = true
    integration_cross_analysis      = true
    integration_master_report       = true
    report_title                = null      // defaults to project_name
    report_interactive          = true      // plotly/ggiraph where supported

    /* =====================================================================
       Notebook paths
       ---------------------------------------------------------------------
       Every stage renders a vendored .qmd. Paths are `projectDir`-relative so
       the repo is relocatable; the source pipelines used `baseDir`, which is
       deprecated and resolves to the launch directory.
       ===================================================================== */

    // QC
    notebook_quality        = "${projectDir}/modules/local/seurat/quality/notebook_seurat_qc.qmd"
    notebook_summarize      = "${projectDir}/modules/local/helper/summarize/notebook_quality_table_report.qmd"
    notebook_merge          = "${projectDir}/modules/local/seurat/merge/notebook_seurat_merge.qmd"
    notebook_scdblfinder    = "${projectDir}/modules/local/scdblfinder/notebook_scdblfinder.qmd"

    // Clustering
    notebook_normalize      = "${projectDir}/modules/local/seurat/normalization/notebook_dimensionality_reduction.qmd"
    notebook_clustering     = "${projectDir}/modules/local/seurat/cluster/notebook_seurat_clustering.qmd"

    // Annotation
    notebook_celltypist     = "${projectDir}/modules/local/celltypist/notebook_celltypist.qmd"
    notebook_sctype_major   = "${projectDir}/modules/local/sctype/major/notebook_sctype_major.qmd"
    notebook_sctype_state   = "${projectDir}/modules/local/sctype/state/notebook_sctype_states.qmd"
    notebook_sctype_agg     = "${projectDir}/modules/local/sctype/aggregate/notebook_sctype_aggregate.qmd"
    notebook_azimuth        = "${projectDir}/modules/local/azimuth/notebook_azimuth.qmd"
    notebook_annotation_concordance = "${projectDir}/modules/local/annotation_concordance/notebook_annotation_concordance.qmd"

    // Batch correction
    notebook_batchcorr      = "${projectDir}/modules/local/batch_correction/notebook_batch_correctionR.qmd"

    // CNV
    notebook_infercnv       = "${projectDir}/modules/local/infercnv/notebook_infercnv.qmd"
    notebook_cnv_concordance = "${projectDir}/modules/local/cnv_concordance/notebook_cnv_concordance.qmd"
    notebook_copykat        = "${projectDir}/modules/local/copykat/notebook_copykat.qmd"

    // Trajectory
    notebook_celltraj       = "${projectDir}/modules/local/cell_trajectory/CellTrajectory.qmd"

    // Metaprograms
    leiden_qmd              = "${projectDir}/modules/local/MetaProg-DE/Metaprog_leiden.qmd"
    nmfprep_qmd             = "${projectDir}/modules/local/MetaProg-DE/Metaprog_NMFprepprocessing.qmd"
    nmf_qmd                 = "${projectDir}/modules/local/MetaProg-DE/Metaprog_NMF.qmd"
    postnmf_qmd             = "${projectDir}/modules/local/MetaProg-DE/Metaprog_PostNMF.qmd"

    // Cell communication
    liana_qmd               = "${projectDir}/modules/local/Cell_Communication/LIANA/Run_LIANA.qmd"
    cellchat_qmd            = "${projectDir}/modules/local/Cell_Communication/CellChat/Run_CellChat.qmd"
    nichenet_qmd            = "${projectDir}/modules/local/Cell_Communication/NicheNet/Run_NicheNet.qmd"

    /* =====================================================================
       Quarto assets (shared by every notebook-rendering process)
       ===================================================================== */
    page_config                 = "${projectDir}/assets/template/_quarto.yml"
    template                    = "${projectDir}/assets/template/*"
    logotype                    = "${projectDir}/assets/template/SCRATCH.png"

    /* =====================================================================
       Publication figure system
       ---------------------------------------------------------------------
       Sourced by every notebook. Sets the house theme, a colour-vision-safe
       categorical palette in fixed slot order, and vector (PDF) output
       alongside every raster figure — globally, so the notebooks' existing
       plotting code needs no changes.
       ===================================================================== */
    viz_library                 = "${projectDir}/assets/viz/*"

    /* =====================================================================
       Resource ceiling
       ===================================================================== */
    max_cpus                    = 16
    max_memory                  = '128.GB'
    max_time                    = '240.h'

    // Reporting / help
    help                        = false
    validate_params             = true
    monochrome_logs             = false
}

/* =========================================================================
   Derived values
   -------------------------------------------------------------------------
   Computed once, after the params block, so every stage agrees. This is what
   removes the "Human" vs "human" hazard the merge exposed.
   ========================================================================= */
params {
    organism_capitalised = params.organism?.toString()?.capitalize() ?: 'Human'
    organism_lower       = params.organism?.toString()?.toLowerCase()  ?: 'human'
    report_title_final   = params.report_title ?: params.project_name
}

/* =========================================================================
   Task staging

   Container options are NOT set here: they are engine-specific and are set
   inside each engine profile below. An earlier revision used
   `containerOptions = { helperFn(workflow.containerEngine) }`, which fails at
   task-submission time with "Cannot invoke method clone() on null object"
   because a top-level `def` helper is not resolvable from inside a process
   directive closure.
   ========================================================================= */

process {
    // The standalone downstream pipelines all used stageInMode 'copy', which
    // duplicates every multi-GB .RDS into each task directory. Symlinks are
    // equivalent here because no process mutates its inputs in place, and they
    // remove a large amount of I/O from the critical path.
    // Override with --stage_mode copy if a site's shared filesystem needs it.
    stageInMode = params.stage_mode
}

/* =========================================================================
   Profiles
   ========================================================================= */

profiles {

    // ---- Container engines ----------------------------------------------
    docker {
        docker.enabled       = true
        docker.fixOwnership  = true
        docker.runOptions    = '--platform=linux/amd64'
        process.containerOptions = '-u $(id -u):$(id -g) -e USERID=$UID -e XDG_CACHE_HOME=/tmp/quarto_cache -e XDG_DATA_HOME=/tmp/quarto_data -e QUARTO_PRINT_STACK=true'
        singularity.enabled  = false
        podman.enabled       = false
        apptainer.enabled    = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = System.getenv('SINGULARITY_CACHEDIR') ?: "${System.getenv('HOME')}/.singularity_cache"
        process.containerOptions = '--env USERID=$UID --env XDG_CACHE_HOME=/tmp/quarto_cache --env XDG_DATA_HOME=/tmp/quarto_data --env QUARTO_PRINT_STACK=true'
        docker.enabled         = false
        podman.enabled         = false
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = System.getenv('APPTAINER_CACHEDIR') ?: "${System.getenv('HOME')}/.apptainer_cache"
        process.containerOptions = '--env USERID=$UID --env XDG_CACHE_HOME=/tmp/quarto_cache --env XDG_DATA_HOME=/tmp/quarto_data --env QUARTO_PRINT_STACK=true'
        docker.enabled       = false
    }

    podman {
        podman.enabled  = true
        docker.enabled  = false
    }

    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }

    // ---- Executors -------------------------------------------------------
    local {
        process.executor = 'local'

        // Detect what this machine ACTUALLY has and cap to it. The defaults
        // (16 cpus / 128 GB) describe a cluster node; on a smaller box
        // `resourceLimits` then clamps to a ceiling the host cannot honour and
        // Nextflow fails the task outright with "requirement exceeds available
        // memory" rather than running it smaller. Detected eagerly into plain
        // values -- a helper referenced from a process directive would not
        // resolve at task time.
        // Probes inlined here rather than assigned to top-level names: the
        // Nextflow 26.x config parser rejects bare variable declarations
        // ("`HOST_CPUS` is not defined"). Closures invoked immediately are
        // still accepted, so the detection happens eagerly exactly as before.
        params.max_cpus = {
            try { Math.max(1, ((Runtime.runtime.availableProcessors() * 0.75) as int)) }
            catch (Exception e) { System.err.println("[SCRATCH-E2E] CPU detection failed (${e.message}); using 4. Pass --max_cpus."); 4 }
        }()

        params.max_memory = {
            try {
                def os = System.getProperty('os.name').toLowerCase()
                long bytes = 0
                if (os.contains('mac')) {
                    bytes = ['sh','-c','sysctl -n hw.memsize'].execute().text.trim() as long
                } else {
                    def l = new File('/proc/meminfo').readLines().find { it.startsWith('MemTotal') }
                    bytes = (l.replaceAll(/\D/, '') as long) * 1024
                }
                int gb = ((bytes / (1024L**3)) * 0.75) as int
                "${Math.max(2, gb)}.GB"
            } catch (Exception e) { System.err.println("[SCRATCH-E2E] memory detection failed (${e.message}); using 8.GB. Pass --max_memory."); '8.GB' }
        }()

        executor {
            cpus   = params.max_cpus
            memory = params.max_memory
        }
    }

    lsf {
        process.executor    = 'lsf'
        process.queue       = { task.time <= 6.h ? 'short' : (task.time <= 24.h ? 'medium' : 'long') }
        executor.perJobMemLimit = true
        executor.queueSize  = 100
        executor.submitRateLimit = '10/1min'
    }

    slurm {
        process.executor   = 'slurm'
        process.queue      = { task.time <= 6.h ? 'short' : (task.time <= 24.h ? 'normal' : 'long') }
        executor.queueSize = 100
        executor.submitRateLimit = '10/1min'
    }

    awsbatch {
        process.executor       = 'awsbatch'
        process.queue          = params.aws_queue ?: 'scratch-e2e-queue'
        aws.region             = params.aws_region ?: 'us-east-1'
        aws.batch.cliPath      = '/home/ec2-user/miniconda/bin/aws'
        aws.batch.maxParallelTransfers = 8
        aws.batch.volumes      = ['/tmp']
        docker.enabled         = true
        // S3 work dir is effectively required on Batch.
        process.errorStrategy  = { task.exitStatus in [104,130,134,137,139,140,143,247] ? 'retry' : 'finish' }
    }

    // Cirro executes the pipeline inside its own managed AWS Batch environment;
    // it supplies executor and work directory, so only the pieces Cirro does not
    // set are configured here.
    cirro {
        docker.enabled      = true
        process.executor    = 'awsbatch'
        params.publish_mode = 'copy'
    }

    // ---- Site profile ----------------------------------------------------
    seadragon {
        process.executor   = 'lsf'
        process.queue      = { task.time <= 6.h ? 'short' : (task.time <= 24.h ? 'medium' : 'long') }
        singularity.enabled    = true
        singularity.autoMounts = true
        executor.perJobMemLimit = true
        params.max_cpus    = 28
        params.max_memory  = '900.GB'
        params.max_time    = '240.h'
    }

    // ---- Development -----------------------------------------------------
    test      { includeConfig 'conf/test.config'  }
    test_full { includeConfig 'conf/test_full.config' }

    // Dry-run the whole DAG with no containers and no real computation.
    stub {
        process.container = null
        process.containerOptions = null
        docker.enabled      = false
        singularity.enabled = false
        params.max_cpus     = 2
        params.max_memory   = '4.GB'
    }

    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
        nextflow.enable.configProcessNamesValidation = true
    }
}

/* =========================================================================
   Included configuration
   ========================================================================= */
includeConfig 'conf/base.config'
includeConfig 'conf/tcr.config'
includeConfig 'conf/containers.config'
includeConfig 'conf/modules.config'
includeConfig 'conf/igenomes.config'

/* =========================================================================
   Reporting
   ========================================================================= */
// Nextflow 26.x's strict config parser rejects top-level `def` declarations
// ("Variable declarations cannot be mixed with config statements"). Assigning
// into params is accepted by both old and new parsers, and keeps ONE timestamp
// shared by all four report files rather than four near-identical ones.
params.trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${params.trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${params.trace_timestamp}.html"   }
trace    {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${params.trace_timestamp}.txt"
    // These extra fields feed the RUN_MANIFEST / MASTER_REPORT resource section.
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${params.trace_timestamp}.html"      }

/* =========================================================================
   Completion handler
   -------------------------------------------------------------------------
   Lived at the top of main.nf until Nextflow 26.x, whose strict script syntax
   permits only declarations there ("Statements cannot be mixed with script
   declarations"). Event handlers are supported in config on every version.
   ========================================================================= */
workflow.onComplete = {
    def line = '=' * 74
    // `log` does not exist in config scope (NullPointerException on
    // "Cannot invoke method info() on null object"); println does.
    println(
        workflow.success
            ? """
            ${line}
             SCRATCH-E2E completed
            ${line}
             Completed : ${workflow.complete}
             Duration  : ${workflow.duration}
             CPU hours : ${workflow.stats.computeTimeFmt}
             Succeeded : ${workflow.stats.succeedCount}   Cached: ${workflow.stats.cachedCount}   Failed: ${workflow.stats.failedCount}
             ${line}
             Results   : ${params.outdir}/${params.project_name}
             Report    : ${params.outdir}/${params.project_name}/master_report/index.html
             Run info  : ${params.outdir}/pipeline_info
            ${line}
            """.stripIndent()
            : """
            ${line}
             SCRATCH-E2E failed
            ${line}
             Completed   : ${workflow.complete}
             Duration    : ${workflow.duration}
             CPU hours   : ${workflow.stats.computeTimeFmt}
             Succeeded   : ${workflow.stats.succeedCount}   Cached: ${workflow.stats.cachedCount}   Failed: ${workflow.stats.failedCount}
             ${line}
             Exit status : ${workflow.exitStatus}
             Error       : ${workflow.errorMessage}
             Resume      : nextflow run . -resume
            ${line}
            """.stripIndent()
    )
}

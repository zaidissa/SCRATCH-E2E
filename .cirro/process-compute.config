/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Cirro compute overrides for SCRATCH-E2E

    Cirro runs the pipeline inside its own managed AWS Batch environment and
    supplies the executor, queue and work directory, so this file carries only
    the pieces Cirro does not: the reference layout, and the ceilings that decide
    which instance types a task can land on.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor      = 'awsbatch'
    errorStrategy = 'retry'
    maxRetries    = 2
}

// NOTE the layout. SCRATCH-E2E's own default is
//   ${igenomes_base}/refdata/refdata-gex-GRCh38-2024-A
// but the bucket the other SCRATCH pipelines read has no `refdata/` level:
//   s3://btc-refdata/scratch/refdata-gex-GRCh38-2024-A
// so `genomes` is redefined here rather than only pointing igenomes_base at S3.
// Taken from SCRATCH-QC-multi-mode/.cirro/qc/process-compute.config — CONFIRM
// against the bucket before the first alignment run; nothing here can check it.
params.igenomes_base = 's3://btc-refdata/scratch'

params {
    genomes {
        'GRCh38' {
            gex = "${params.igenomes_base}/refdata-gex-GRCh38-2024-A"
            vdj = "${params.igenomes_base}/refdata-cellranger-vdj-GRCh38-alts-ensembl-7.1.0"
        }
        'GRCm39' {
            gex = "${params.igenomes_base}/refdata-gex-GRCm39-2024-A"
            vdj = "${params.igenomes_base}/refdata-cellranger-vdj-GRCm38-alts-ensembl-7.0.0"
        }
    }

    // Ceilings, not requests. base.config asks for 160 GB for INFERCNV and
    // 128 GB for CELLTRAJECTORY; resourceLimits caps every task at these values,
    // so a queue whose largest instance is smaller will have tasks that can
    // never be placed and will sit in RUNNABLE indefinitely rather than fail.
    // Lower max_memory to match the queue if that happens.
    max_cpus   = 32
    max_memory = '240.GB'
    max_time   = '48.h'
}

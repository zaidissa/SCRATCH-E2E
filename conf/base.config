/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SCRATCH-E2E — Base resource model
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    One resource model for all eleven stages.

    The eight standalone pipelines each carried their own copy of a `check_max`
    closure and their own max_cpus/max_memory (10-32 cpus, 60-650 GB), which made
    the effective ceiling depend on whichever pipeline you happened to launch.
    Here a single `resourceLimits` (Nextflow >= 23.10) caps everything, and the
    retry escalation is expressed as multipliers on the label defaults.

    Escalation: a task killed for running out of memory (137/140/143/247) is
    retried with proportionally more RAM and wall time rather than failing the
    run. This matters most for INFERCNV, METAPROG_NMF and CELLCHAT, which are
    the three stages that most often die on large objects.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1                   * task.attempt }
    memory = { 6.GB                * task.attempt }
    time   = { 4.h                 * task.attempt }

    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time   as nextflow.util.Duration
    ]

    // 130/143/137/104/134/139 -> signal-related (OOM kill, bus error, segfault)
    // 247                     -> LSF/Slurm memory-limit kill
    errorStrategy = { task.exitStatus in [104,130,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // ---- Queue placement -------------------------------------------------
    // EVERYTHING goes to the ON-DEMAND queue, not spot.
    //
    // Cirro submits everything to its spot queue by default. Spot is wrong for
    // this pipeline. A full --from align --to metaprog run takes days, nothing
    // here checkpoints, and a reclaimed host throws away the whole task:
    // none of these tools checkpoints, so a reclaimed host throws away the
    // whole task, and the probability of being reclaimed grows with runtime.
    // Measured on Cirro 2026-10-21/22, dataset 389dd862, every single failure
    // in a 23h 43m run was `Host EC2 (instance i-...) terminated` -- not one
    // OOM, not one script error:
    //   INFERCNV        killed 3/3 attempts at 5h05m, 11h59m and 6h38m, the
    //                   third inside `infer_cnv_run part 2` (chunk 24/59),
    //                   which exhausted maxRetries and killed the run.
    //   NUMBAT_PILEUP   2 of 15 killed at ~4h; both passed on retry.
    //   NUMBAT_RUN      the 3 largest samples killed after 8-11h, repeatedly.
    // 51.3% of that run's 1,481 CPU hours were spent on work that was thrown
    // away. The 12 samples whose Numbat calls DID land all finished inside
    // ~90 minutes, which is the whole pattern: short tasks survive spot, long
    // tasks do not. On a pipeline where the long tasks are the point, that is
    // not a tradeoff worth taking -- on-demand costs roughly 2-3x spot per
    // hour, and that run spent 51.3% of its hours on discarded work, so spot
    // was not even the cheaper option here.
    //
    // `withName: '.*'`, not a plain `process.queue`. Cirro sets the queue as a
    // GENERAL process setting in the config it passes with `-config`, which has
    // the last word over any general setting written here -- so a general
    // assignment would be silently ignored. A selector outranks a general
    // setting regardless of which file it came from, and '.*' matches every
    // process name. Measured on 25.04.8 with the slurm executor, reading the
    // queue back out of the generated submit scripts: with a -config file
    // setting the queue generally, all three test processes still resolved to
    // the selector's queue, while the same test WITHOUT the catch-all gave a
    // non-selected process the -config value. It sets only `queue`, so it does
    // not disturb the cpus/memory/time selectors below.
    //
    // The ARN comes from the environment Cirro gives the headnode, so nothing
    // is hardcoded and no other executor is affected -- off Cirro both
    // variables are unset, this resolves to null, and the local executor
    // ignores `queue` entirely.
    withName: '.*' {
        queue = System.getenv('PW_ONDEMAND_JOB_QUEUE') ?: System.getenv('PW_SPOT_JOB_QUEUE')
    }

    // ---- Generic labels --------------------------------------------------
    withLabel: process_single {
        cpus   = { 1     * task.attempt }
        memory = { 6.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withLabel: process_low {
        cpus   = { 4     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { 12    * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withLabel: process_high {
        cpus   = { 20    * task.attempt }
        memory = { 120.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }

    // For the few genuinely memory-bound steps: scale RAM hard, CPUs barely.
    // Extra cores do not help a step that is bounded by one big in-memory matrix.
    withLabel: process_high_memory {
        cpus   = { 8      * task.attempt }
        memory = { 200.GB * task.attempt }
        time   = { 24.h   * task.attempt }
    }

    withLabel: error_ignore { errorStrategy = 'ignore' }
    withLabel: error_retry  { errorStrategy = 'retry'; maxRetries = 3 }

    // ---- Per-process tuning ---------------------------------------------
    // Values reflect what these tools actually need on a typical tumour
    // scRNA-seq cohort; they are still capped by resourceLimits above.

    // Alignment: CellRanger wants many cores and a large reference in RAM.
    withName: 'CELLRANGER_(COUNT|MULTI)' {
        cpus   = { 16     * task.attempt }
        memory = { 64.GB  * task.attempt }
        time   = { 24.h   * task.attempt }
    }
    withName: 'CELLRANGER_VDJ' {
        cpus   = { 8      * task.attempt }
        memory = { 32.GB  * task.attempt }
        time   = { 12.h   * task.attempt }
    }
    withName: 'AUTO_DEMUX' {
        cpus   = { 8      * task.attempt }
        memory = { 32.GB  * task.attempt }
        time   = { 12.h   * task.attempt }
    }
    withName: 'SAMPLESHEET_CHECK' {
        cpus = 1; memory = { 2.GB * task.attempt }; time = { 1.h * task.attempt }
    }

    // CellBender is GPU-capable; on CPU it is long-running but not RAM-hungry.
    // CellBender is a GPU tool; on CPU it is bounded by threads, and its epoch
    // time scales with them (measured: 135 s/epoch at 8 threads on 33k droplets,
    // 38k genes). The old 32.GB request was the binding constraint rather than
    // the real footprint — it forced samples to run one at a time on a 40 GB
    // budget, doubling wall clock for no benefit. 20.GB lets two run side by
    // side; a genuine overrun escalates to 40 and then 60 on retry.
    withName: 'CELLBENDER' {
        cpus   = { 8      * task.attempt }
        memory = { 20.GB  * task.attempt }
        time   = { 24.h   * task.attempt }
        // The last attempt is `ignore`, not fatal: qc.nf gives a sample CellBender
        // could not finish its cellranger filtered matrix and says so in its QC
        // report. Fatal meant one library took every finished sample down with it.
        // A withName selector outranks the generic errorStrategy Cirro sets.
        maxRetries    = 2
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
    }

    withName: 'DECONTX' {
        // Variational EM over the CELL matrix, so it is sized by cells rather
        // than by every droplet the way CellBender is, and finishes without a
        // GPU. Same fallback contract as CELLBENDER: the last attempt is
        // `ignore`, and qc.nf then analyses that sample from cellranger's
        // filtered matrix with the status recorded in its QC report.
        cpus   = { 8      * task.attempt }
        memory = { 32.GB  * task.attempt }
        time   = { 6.h    * task.attempt }
        maxRetries    = 1
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
    }

    // Per-sample QC is small; the merge is where the object gets big.
    withName: 'SEURAT_QUALITY' {
        cpus   = { 4      * task.attempt }
        memory = { 24.GB  * task.attempt }
    }
    withName: 'SEURAT_MERGE' {
        cpus   = { 8      * task.attempt }
        memory = { 96.GB  * task.attempt }
        time   = { 12.h   * task.attempt }
    }
    withName: 'SCDBLFINDER' {
        cpus   = { 12     * task.attempt }
        memory = { 64.GB  * task.attempt }
    }

    // Integration/clustering: memory-bound on the merged object.
    withName: 'SEURAT_(NORMALIZE|CLUSTER)' {
        cpus   = { 12     * task.attempt }
        memory = { 96.GB  * task.attempt }
        time   = { 16.h   * task.attempt }
    }
    withName: 'BATCHCORRECTION' {
        cpus   = { 16     * task.attempt }
        memory = { 128.GB * task.attempt }
        time   = { 24.h   * task.attempt }
    }

    // inferCNV is the single most memory-hungry step in the whole pipeline.
    withName: 'INFERCNV' {
        cpus   = { 8      * task.attempt }
        memory = { 160.GB * task.attempt }
        time   = { 36.h   * task.attempt }
        // One caller's failure must not destroy a finished cohort -- the same
        // rule NUMBAT_RUN already has, for the same reason.
        //
        // Cirro 2026-10-23 (dataset f90848d7): 68 tasks succeeded, including
        // every one of the 15 Numbat calls, and the run still ended with
        // nothing because INFERCNV could not stage three .js/.R/.py assets
        // (a 404 on workdir/stage-.../scratch_viz.R, so inferCNV itself never
        // ran). Cirro's -config sets a flat process.errorStrategy = 'retry'
        // and INFERCNV had no withName override, so it retried twice and then
        // took 1,166.7 CPU hours down with it.
        //
        // The pipeline is ALREADY built for inferCNV producing nothing:
        // meta_object is an optional output, cnv.nf passes
        // ch_infercnv_meta.collect().ifEmpty([]) to CNV_CONCORDANCE, and
        // ch_cnv_object falls back to the annotated object. With
        // cnv_caller_priority = 'numbat' the caller STRATIFY trusts most is a
        // different process entirely. So losing inferCNV should DEGRADE the
        // run, not end it -- and STRATIFY now raises a caution when no caller
        // contributed at all, which is what keeps 'ignore' honest.
        maxRetries    = 2
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
    }
    withName: 'SCEVAN|COPYKAT_PROCESS' {
        cpus   = { 12     * task.attempt }
        memory = { 96.GB  * task.attempt }
        time   = { 24.h   * task.attempt }
        // Same argument as INFERCNV above: optional callers behind a consensus.
        maxRetries    = 2
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
    }

    // Metaprograms: NMF fans out per sample, so each task can stay modest.
    withName: 'METAPROG_LEIDEN|METAPROG_NMF_PREP' {
        cpus   = { 12     * task.attempt }
        memory = { 64.GB  * task.attempt }
    }
    withName: 'METAPROG_NMF' {
        cpus   = { 12     * task.attempt }
        memory = { 48.GB  * task.attempt }
        time   = { 24.h   * task.attempt }
    }
    // The python engine is markedly faster and leaner than the R NMF package
    // for the same rank sweep, so it gets a smaller default slot.
    withName: 'METAPROG_NMF_PY' {
        cpus   = { 8      * task.attempt }
        memory = { 24.GB  * task.attempt }
        time   = { 8.h    * task.attempt }
    }
    withName: 'METAPROG_POST' {
        cpus   = { 4      * task.attempt }
        memory = { 32.GB  * task.attempt }
    }

    withName: 'CELLTRAJECTORY' {
        cpus   = { 16     * task.attempt }
        memory = { 128.GB * task.attempt }
        time   = { 24.h   * task.attempt }
    }

    // CellChat holds a dense LR-by-cell tensor; NicheNet is lighter.
    withName: 'CELLCOMM_CELLCHAT' {
        cpus   = { 12     * task.attempt }
        memory = { 96.GB  * task.attempt }
        time   = { 24.h   * task.attempt }
    }
    withName: 'CELLCOMM_LIANA|CELLCOMM_NICHENET' {
        cpus   = { 8      * task.attempt }
        memory = { 48.GB  * task.attempt }
        time   = { 16.h   * task.attempt }
    }

    // TCR: clustering tools are CPU-bound on pairwise CDR3 distances.
    withName: 'VDJ_QC' {
        cpus = { 4 * task.attempt }; memory = { 16.GB * task.attempt }
    }
    withName: 'TCELL_INTEGRATION' {
        cpus = { 8 * task.attempt }; memory = { 64.GB * task.attempt }
    }
    withName: 'TCRDIST3|GIANA|GLIPH2|CONGA' {
        cpus   = { 16     * task.attempt }
        memory = { 48.GB  * task.attempt }
        time   = { 16.h   * task.attempt }
    }
    withName: 'TCRI|REPERTOIRE|CONSENSUS_CLUSTERING|MASTER_SUMMARY' {
        cpus = { 4 * task.attempt }; memory = { 24.GB * task.attempt }
    }

    // Numbat: the pileup walks the whole BAM and is I/O and CPU bound; the
    // model fit is memory bound on the allele table.
    withName: 'NUMBAT_PREP' {
        cpus   = { 4      * task.attempt }
        memory = { 64.GB  * task.attempt }
        time   = { 4.h    * task.attempt }
    }
    withName: 'NUMBAT_PILEUP' {
        // One task per INDIVIDUAL now, walking every BAM that individual
        // contributed rather than one.
        //
        // The libraries are piled up SEQUENTIALLY, and that is Numbat's own
        // design, not a choice here. pileup_and_phase.R builds one
        // cellsnp-lite command per sample, writes them one-per-line into
        // run_pileup.sh and runs `sh run_pileup.sh` -- so wall time is the SUM
        // over the individual's libraries, not the max. Eagle2 phasing is
        // issued the same way, one command per chromosome. Each cellsnp-lite
        // call does use -p ${task.cpus} internally, so the cores are not idle;
        // the serialisation is across samples.
        //
        // That turns the per-individual fix into a wall-time trade: 17 parallel
        // ~hours-long tasks become one task of roughly 17x that. GBM1-DFCI3 is
        // a single patient with all 17 GEX libraries (DFCI<n> is the
        // individual, S<n> the timepoint), which is the worst case for this
        // process -- there is no second group to run alongside it.
        //
        // 120 h is an ESTIMATE, not a measurement: the 2026-10 run had 2 of 15
        // single-library pileups killed at ~4 h on spot, so ~17 x 4 h plus
        // phasing does not fit in 48 h. `* task.attempt` caps at 240 h, which
        // is params.max_time. Replace this with the real number from that run's
        // report.html rather than trusting the arithmetic.
        cpus   = { 16     * task.attempt }
        memory = { 48.GB  * task.attempt }
        time   = { 120.h  * task.attempt }
    }
    withName: 'NUMBAT_RUN' {
        // Pooled per individual, so the count matrix is the sum of that
        // patient's libraries rather than one of them -- fewer tasks, each
        // larger. Memory and wall time raised to match; max_memory/max_time in
        // .cirro/process-compute.config (240 GB / 240 h) still cap them.
        //
        // Sized for ONE group holding all 17 libraries: GBM1-DFCI3 is a single
        // individual, so the pooled count matrix is the whole cohort (~59.6k
        // cells post-QC) rather than one library's ~3.5k. The 2026-10 run lost
        // its 3 largest SINGLE-library calls at 8-11 h, and this is an order of
        // magnitude larger than those were.
        //
        // Also an estimate. 192 GB x attempt is capped at 240 GB by
        // params.max_memory on the retry, so if the first attempt dies on
        // memory there is only one step left -- peak RSS from report.html is
        // what should set this.
        cpus   = { 12     * task.attempt }
        memory = { 192.GB * task.attempt }
        time   = { 96.h   * task.attempt }
        // One sample's CNV call must not kill a 17-library cohort.
        //
        // NUMBAT_RUN is per-sample and the rest of the pipeline is already
        // built for a sample having no call: NUMBAT_PREP warns which samples it
        // is skipping, cnv.nf collects the calls with `.ifEmpty([])`, and
        // STRATIFY falls back to the other callers or the annotation label for
        // those cells. So a sample that cannot be called is a known, handled
        // state -- but a sample that FAILS was taking the whole run down with
        // it. On Cirro 2026-10-22 twelve of fifteen samples had finished calls
        // and the run still ended with nothing, because the thirteenth
        // exhausted its retries.
        //
        // Retry twice (spot reclamation usually clears), then give up on that
        // one sample and let the cohort finish. 'ignore' is deliberate rather
        // than a bigger maxRetries: if three attempts cannot place or complete
        // a sample, more attempts will not either, and a partial cohort beats
        // no cohort. The skipped sample is visible in the Numbat join report
        // and in CNV_CONCORDANCE, so it cannot pass unnoticed.
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
    }

    // Drawing Numbat's figures reads TSVs and RDS files that are already on
    // disk -- no model fit, no BAM. The memory is for gexp_roll_wide, the
    // smoothed expression matrix, which is cells x genes and is read whole
    // before plot_exp_roll subsamples 300 cells from it.
    withName: 'NUMBAT_REPORT' {
        cpus   = { 2      * task.attempt }
        memory = { 36.GB  * task.attempt }
        time   = { 2.h    * task.attempt }
        // A picture must never cost a call. Every figure is already guarded
        // inside numbat_figures.R, which records a failure in its manifest and
        // exits 0, so reaching this means the task itself died -- and even then
        // the CNV calls it was drawing are complete and published.
        //
        // Declared HERE and not as a directive in the process body: Cirro
        // passes .cirro/process-compute.config with `-config`, and that file
        // sets a flat `process.errorStrategy = 'retry'` which overrides any
        // errorStrategy written in a process body. A `withName` selector
        // outranks it. Measured on 26.04.6: with process.errorStrategy =
        // 'retry' in the -config file, a process carrying this selector ran
        // once and was ignored while an unselected one retried and failed the
        // run.
        errorStrategy = 'ignore'
    }

    // Report rendering is light; it reads published artefacts, not objects.
    withName: 'STAGE_REPORT' {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }

    // The split loads the annotated object plus every caller's per-cell table.
    withName: 'STRATIFY_COMPARTMENTS' {
        cpus   = { 8      * task.attempt }
        memory = { 96.GB  * task.attempt }
        time   = { 8.h    * task.attempt }
    }
    withName: 'TME_CHARACTERISATION' {
        cpus   = { 8      * task.attempt }
        memory = { 64.GB  * task.attempt }
        time   = { 8.h    * task.attempt }
    }

    // Integration layer: reads many small artefacts plus one big object.
    withName: 'INTEGRATE_OBJECTS' {
        cpus   = { 8      * task.attempt }
        memory = { 96.GB  * task.attempt }
        time   = { 8.h    * task.attempt }
    }
    withName: 'CROSS_ANALYSIS' {
        cpus   = { 8      * task.attempt }
        memory = { 64.GB  * task.attempt }
    }
    // CellTypist is the one notebook rendered through Quarto's JUPYTER engine
    // rather than knitr, and jupyter_client gives a new kernel 60 seconds to
    // answer. Under QEMU (the docker profile forces linux/amd64, so everything
    // is emulated on Apple silicon), a kernel racing several other heavyweight
    // containers can miss that window and die with "Kernel didn't respond in 60
    // seconds" before a line of the notebook has run. It is a startup race, not
    // an analysis failure, and it exits 1 — which the global strategy treats as
    // fatal, sinking the whole run at the annotation stage.
    withName: 'CELLTYPIST_ANNOTATION' {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    // Report assembly must not sink a 40-hour run: never fail the pipeline.
    withName: 'RUN_MANIFEST|MASTER_REPORT' {
        cpus          = { 2 * task.attempt }
        memory        = { 16.GB * task.attempt }
        time          = { 4.h * task.attempt }
        errorStrategy = 'ignore'
    }
}

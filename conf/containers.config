/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SCRATCH-E2E — Container registry
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Every process image is declared here and nowhere else.

    In the eight standalone pipelines images were hardcoded inside each module,
    which produced three portability bugs that are fixed by centralising them:

      * absolute .sif paths that only resolved on one machine, e.g.
        '/home/sazaidi/Softwares/SCRATCH-QC-main/scratch-align.sif'
        (AUTO_DEMUX, CELLRANGER_MKFASTQ, CELLRANGER_MULTI)
        and '/path/to/scratch-batchcorr.sif' (BATCHCORRECTION)
      * local-only tags never pushed to a registry ('nf-quarto:latest')
      * SEURAT_MERGE had its container line commented out, so it silently
        inherited whatever process.container happened to be set to

    Override any single image from the CLI without editing this file:
        --container_qc 'myrepo/scratch-qc:v2'
    or swap the whole registry prefix for an air-gapped mirror:
        --container_registry 'registry.internal.org/scratch'
----------------------------------------------------------------------------------------
*/

params {

    // Set to e.g. 'registry.internal.org/scratch' to pull every SCRATCH image
    // from a private mirror. Empty string means "use the defaults verbatim".
    container_registry     = ''

    // Per-stage images. Each is independently overridable on the command line.
    container_cellranger   = 'syedsazaidi/cellranger:v9.0.1'
    container_align        = 'syedsazaidi/scratch-cellranger8:latest'
    container_cellbender   = 'us.gcr.io/broad-dsde-methods/cellbender:0.3.0'
    // scratch-qc + celda (docker/scratch-decontx.Dockerfile): the QC image
    // already carries Seurat, DropletUtils and hdf5r, which decontx_run.R needs.
    container_decontx      = 'syedsazaidi/scratch-decontx:latest'
    container_qc           = 'syedsazaidi/scratch-qc:latest'
    container_cluster      = 'syedsazaidi/scratch-cluster:latest'
    // DO NOT move this back to `:latest`. That tag (2026-02-13 build) ships
    // Seurat 5.0.0 against SeuratObject 5.3.0, and Seurat 5.0.0 still calls
    // `PackageCheck()` and `FetchData(slot=)` internally. SeuratObject made both
    // DEFUNCT after 5.2.0, so the annotation stage dies inside Seurat's own code
    // and no notebook can work around it — nothing in this repository calls
    // either function. Measured on Cirro 2026-10-16 (run aborted, 5 failed
    // tasks) and reproduced locally on a 300-cell object:
    //     SCEASY_CONVERTER_ONE  -> PackageCheck(), from as.SingleCellExperiment()
    //     SCYTPE_MAJOR          -> FetchData(slot=), from FeaturePlot()
    //
    // `:seuratobject-5.2.0` is :latest plus SeuratObject pinned to 5.2.0
    // (docker/scratch-annotation-so.Dockerfile). 5.2.0 because that is what
    // syedsazaidi/scratch-cluster:latest carries against the same Seurat 5.0.0,
    // and that pairing runs the clustering notebook in production — so the two
    // images now agree rather than using a third combination. Verified in the
    // image with bin/sceasy_converter.R (writes the h5ad) and a full
    // `quarto render notebook_sctype_major.qmd`, which produces all three
    // declared outputs and its figures; the same two commands fail on :latest.
    container_annotation   = 'syedsazaidi/scratch-annotation:seuratobject-5.2.0'
    container_batchcorr    = 'syedsazaidi/scratch-batchcor:V1'
    container_cnv          = 'syedsazaidi/scratch-cnv:latest'
    container_metaprog     = 'syedsazaidi/scratch-tumorheterogenity:V1'
    container_trajectory   = 'syedsazaidi/scratch-celltrajectory:latest'
    container_cellcomm     = 'syedsazaidi/scratch-cellcommunication:latest'
    container_tcr          = 'syedsazaidi/scratch-tcr:latest'
    container_gliph2       = 'syedsazaidi/scratch-gliph2:latest'

    // Numbat needs the R package plus Eagle2 and samtools. The upstream project
    // publishes an image; confirm the tag before a production run, or point this
    // at your own build (see docs/NUMBAT.md).
    // 'pkgs/numbat:latest' was a placeholder that does not exist on any registry
    // -- `--run_numbat true` failed at image pull before running anything. This
    // is the Numbat authors' own image (kharchenkolab), verified to resolve.
    // Built by containers/numbat/Dockerfile = upstream + procps. Nextflow's task
    // wrapper hard-exits 1 if `ps` is absent whenever trace/report/timeline are
    // enabled (they are), so every NUMBAT task died in ~3s having never run its
    // script. Upstream ships no procps. Everything else -- the numbat R package,
    // Eagle2, samtools, and the bundled /data references -- is unchanged.
    //
    // This WAS 'scratch-numbat:procps', a local-only tag, which is the very bug
    // this file's header calls out. A bare reference has no '/', so Docker reads
    // it as a Hub official image and AWS Batch answered with "denied: requested
    // access to the resource is denied". That is a task-START failure, so retries
    // cannot help and the entire pileup fan-out is submitted before anything
    // fails -- Cirro 2026-10-20 burned 1h50m and 33 CPU-hours producing no calls.
    // subworkflows/local/numbat.nf now refuses to start the stage on a non-local
    // executor while this value has no '/' in it, so that is a two-second error
    // from here on.
    //
    // Verified pullable the way Batch pulls it, anonymously against
    // registry-1.docker.io (2026-10-20): the tag resolves to an OCI index
    // carrying a linux/amd64 manifest, its 24 layers and config blob are all
    // reachable with an anonymous token, and the top layer of the config history
    // is the procps install -- which is the only reason this image exists.
    // 21.0 GB compressed, 19.2 GB of it the bundled 1000G panel.
    container_numbat       = 'syedsazaidi/scratch-numbat:procps'

    // Python NMF engine for the metaprogram stage (scanpy + scikit-learn).
    // Reuses the cell-communication image, which already ships scanpy/sklearn.
    container_nmf_python   = 'syedsazaidi/scratch-cellcommunication:latest'

    // Integration / reporting layer. Quarto + R + python plotting stack.
    container_integration  = 'syedsazaidi/scratch-cluster:latest'

    // TME's compositional differential abundance runs in R (speckle/propeller),
    // which the shared analysis image does not carry. Built by
    // containers/tme/Dockerfile -- a few MB on top of container_integration.
    container_tme          = 'syedsazaidi/scratch-tme:latest'

    // Opt-in only, selected when `--run_scoda true`. Adds ~2 GB because scCODA
    // implements its sampler on TensorFlow Probability. Built by
    // containers/tme/Dockerfile.scoda ON TOP of container_tme, so enabling
    // scCODA never loses propeller.
    container_tme_scoda    = 'syedsazaidi/scratch-tme-scoda:latest'

    // Retained for backwards compatibility with the standalone TCR pipeline,
    // whose modules referenced `params.container` directly.
    container              = null
}

// Resolve the registry prefix ONCE, here, into concrete strings.
//
// An earlier revision assigned `container = { scratchImage(params.x) }`. That is
// unsafe: a top-level `def` helper is not reliably resolvable from inside a
// process-directive closure at task-execution time, and it also produced
// "Access to undefined parameter" warnings on every run. Resolving eagerly into
// plain strings removes both problems.
//
// Third-party images (cellbender, cellranger) are never re-prefixed.
params {
    container_registry_prefix = params.container_registry?.toString()?.trim()

    image_align        = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_align.tokenize('/').last()}" : params.container_align
    image_qc           = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_qc.tokenize('/').last()}" : params.container_qc
    image_cluster      = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_cluster.tokenize('/').last()}" : params.container_cluster
    image_annotation   = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_annotation.tokenize('/').last()}" : params.container_annotation
    image_batchcorr    = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_batchcorr.tokenize('/').last()}" : params.container_batchcorr
    image_cnv          = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_cnv.tokenize('/').last()}" : params.container_cnv
    image_decontx      = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_decontx.tokenize('/').last()}" : params.container_decontx
    image_metaprog     = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_metaprog.tokenize('/').last()}" : params.container_metaprog
    image_nmf_python   = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_nmf_python.tokenize('/').last()}" : params.container_nmf_python
    image_trajectory   = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_trajectory.tokenize('/').last()}" : params.container_trajectory
    image_cellcomm     = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_cellcomm.tokenize('/').last()}" : params.container_cellcomm
    image_tcr          = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_tcr.tokenize('/').last()}" : params.container_tcr
    image_gliph2       = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_gliph2.tokenize('/').last()}" : params.container_gliph2
    image_integration  = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_integration.tokenize('/').last()}" : params.container_integration
    image_tme          = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_tme.tokenize('/').last()}" : params.container_tme
    image_tme_scoda    = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_tme_scoda.tokenize('/').last()}" : params.container_tme_scoda
    image_numbat       = params.container_registry_prefix ? "${params.container_registry_prefix}/${params.container_numbat.tokenize('/').last()}" : params.container_numbat
}

process {

    // ---- Alignment ------------------------------------------------------
    withName: 'SAMPLESHEET_CHECK'   { container = params.image_align }
    withName: 'AUTO_DEMUX'          { container = params.image_align }
    withName: 'CELLRANGER_COUNT'    { container = params.container_cellranger }
    withName: 'CELLRANGER_VDJ'      { container = params.container_cellranger }
    withName: 'CELLRANGER_MULTI'    { container = params.container_cellranger }

    // ---- Quality control ------------------------------------------------
    withName: 'CELLBENDER'          { container = params.container_cellbender }
    // Only needs curl and the fetch script on PATH; reuse the cellcomm image
    // rather than pulling a new one just to download files.
    withName: 'NICHENET_FETCH_REFS' { container = params.image_cellcomm }
    // Reuses the CellBender image purely because it already carries h5py; the
    // process itself is a thirty-second file rewrite, not an analysis step.
    withName: 'CELLBENDER_TO_CELLRANGER' { container = params.container_cellbender }
    withName: 'DECONTX'             { container = params.image_decontx }
    withName: 'SEURAT_QUALITY'      { container = params.image_qc }
    withName: 'HELPER_SUMMARIZE'    { container = params.image_qc }
    withName: 'SEURAT_MERGE'        { container = params.image_qc }
    withName: 'SCDBLFINDER'         { container = params.image_qc }

    // ---- Clustering -----------------------------------------------------
    withName: 'SEURAT_NORMALIZE'    { container = params.image_cluster }
    withName: 'SEURAT_CLUSTER'      { container = params.image_cluster }

    // ---- Annotation -----------------------------------------------------
    withName: 'HELPER_SEURAT_SUBSET'         { container = params.image_annotation }
    withName: 'HELPER_SCEASY_CONVERTER.*'    { container = params.image_annotation }
    withName: 'CELLTYPIST_ANNOTATION'        { container = params.image_annotation }
    withName: 'SCYTPE_MAJOR_ANNOTATION'      { container = params.image_annotation }
    withName: 'SCYTPE_STATE_ANNOTATION'      { container = params.image_annotation }
    withName: 'SCYTPE_AGGREGATE_ANNOTATION'  { container = params.image_annotation }
    withName: 'AZIMUTH_ANNOTATION'           { container = params.image_annotation }
    withName: 'ANNOTATION_CONCORDANCE'       { container = params.image_annotation }

    // ---- Batch correction -----------------------------------------------
    withName: 'BATCHCORRECTION'     { container = params.image_batchcorr }

    // ---- Copy number ----------------------------------------------------
    withName: 'INFERCNV'            { container = params.image_cnv }
    withName: 'CNV_CONCORDANCE'     { container = params.image_cnv }
    withName: 'COPYKAT_PROCESS'     { container = params.image_cnv }

    // ---- Tumour heterogeneity / metaprograms ----------------------------
    withName: 'METAPROG_LEIDEN'     { container = params.image_metaprog }
    withName: 'METAPROG_EXPORT_MTX' { container = params.image_metaprog }
    withName: 'METAPROG_NMF_PREP'   { container = params.image_metaprog }
    withName: 'METAPROG_NMF'        { container = params.image_metaprog }
    withName: 'METAPROG_NMF_PY'     { container = params.image_nmf_python }
    withName: 'METAPROG_POST'       { container = params.image_metaprog }

    // ---- Trajectory -----------------------------------------------------
    withName: 'CELLTRAJECTORY'      { container = params.image_trajectory }

    // ---- Cell communication ---------------------------------------------
    withName: 'CELLCOMM_LIANA'      { container = params.image_cellcomm }
    withName: 'CELLCOMM_CELLCHAT'   { container = params.image_cellcomm }
    withName: 'CELLCOMM_NICHENET'   { container = params.image_cellcomm }

    // ---- TCR ------------------------------------------------------------
    // GLIPH2 needs its own image (the GLIPH2 binary is not in the TCR image).
    withName: 'GLIPH2'              { container = params.image_gliph2 }
    withName: 'VDJ_QC'              { container = params.image_tcr }
    withName: 'TCELL_INTEGRATION'   { container = params.image_tcr }
    withName: 'TCRI'                { container = params.image_tcr }
    withName: 'CONGA'               { container = params.image_tcr }
    withName: 'TCRDIST3'            { container = params.image_tcr }
    withName: 'GIANA'               { container = params.image_tcr }
    withName: 'REPERTOIRE'          { container = params.image_tcr }
    withName: 'CONSENSUS_CLUSTERING' { container = params.image_tcr }
    withName: 'MASTER_SUMMARY'      { container = params.image_tcr }

    // ---- Compartment split & microenvironment ---------------------------
    // Both are Seurat + ggplot2 work; the CNV image already carries the
    // packages needed to read inferCNV/SCEVAN objects.
    // Only needs curl/unzip/tar, all present in the CNV image. Without a
    // selector it would run uncontainerised on the host -- fine on a laptop,
    // broken on HPC.
    withName: 'NUMBAT_FETCH_REFS' { container = params.image_cnv }
    withName: 'NUMBAT_PREP'    { container = params.image_cnv }
    withName: 'NUMBAT_PILEUP'  { container = params.image_numbat }
    withName: 'NUMBAT_RUN'     { container = params.image_numbat }

    withName: 'STAGE_REPORT'          { container = params.image_integration }
    withName: 'STRATIFY_COMPARTMENTS' { container = params.image_cnv }
    // Resolved eagerly at config-parse time, not in a closure -- see the note
    // above about top-level helpers being unreachable from process directives.
    // Nobody pays for TensorFlow unless they asked for scCODA.
    withName: 'TME_CHARACTERISATION'  { container = (params.run_scoda.toString().toLowerCase() in ['true','yes','y','on','1']) ? params.image_tme_scoda : params.image_tme }

    // ---- Cross-stage integration & reporting ----------------------------
    withName: 'INTEGRATE_OBJECTS'   { container = params.image_integration }
    withName: 'CROSS_ANALYSIS'      { container = params.image_integration }
    withName: 'RUN_MANIFEST'        { container = params.image_integration }
    withName: 'MASTER_REPORT'       { container = params.image_integration }
}

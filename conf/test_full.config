/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SCRATCH-E2E — full-size test profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A realistic end-to-end run on a real cohort. Point the inputs at your data
    and launch with an executor profile, e.g.

        nextflow run . -profile test_full,singularity,lsf
----------------------------------------------------------------------------------------
*/

params {
    project_name   = 'scratch_e2e_full'

    max_cpus       = 24
    max_memory     = '250.GB'
    max_time       = '240.h'

    from           = 'align'
    to             = 'end'

    input_samplesheet = null   // set me
    input_exp_table   = null   // set me

    modality       = 'GEX+TCR'
    genome         = 'GRCh38'
    organism       = 'human'

    metaprog_nmf_engine = 'python'
}

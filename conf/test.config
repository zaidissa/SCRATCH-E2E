/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SCRATCH-E2E — minimal test profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Small-footprint settings for CI and for `-stub` runs that exercise the full
    DAG without real computation:

        nextflow run . -profile test,stub -stub

    Use `-profile test_full` for a real end-to-end run on a small cohort.
----------------------------------------------------------------------------------------
*/

params {
    project_name   = 'scratch_e2e_test'

    max_cpus       = 2
    max_memory     = '6.GB'
    max_time       = '2.h'

    // NOTE: `from`/`to` are deliberately NOT set here. Params assigned in a
    // profile take precedence over the command line, so pinning them would make
    // `--from`/`--to` silently ineffective whenever -profile test is used.
    // The defaults in nextflow.config already run the whole DAG.

    input_samplesheet = "${projectDir}/assets/samplesheets/test_sample_table.csv"
    input_exp_table   = "${projectDir}/assets/samplesheets/test_meta_data.csv"

    modality       = 'GEX'
    genome         = 'GRCh38'

    // Keep the optional heavy tools off by default in CI.
    skip_cellbender = true
    skip_copykat    = true

    // The python engine is the one under test; it is also the default.
    metaprog_nmf_engine = 'python'
    metaprog_rank_lb    = 2
    metaprog_rank_ub    = 3
    metaprog_nrun       = 1
}

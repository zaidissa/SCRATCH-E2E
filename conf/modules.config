/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SCRATCH-E2E — Per-process publishing and notebook parameters
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    This file is the translation layer between the namespaced Nextflow
    parameters (see nextflow.config) and the original `-P key:value` names the
    vendored .qmd notebooks expect. Keeping the mapping here is what allowed
    the 38 notebooks to be vendored unmodified.

    Output layout — every stage publishes into the same three-way structure so
    the integration layer can find artefacts by convention rather than by a
    hardcoded path per stage:

        <outdir>/<project>/<stage>/report/    rendered .html
        <outdir>/<project>/<stage>/figures/   .png/.pdf
        <outdir>/<project>/<stage>/data/      .RDS/.csv/.h5ad

    The standalone pipelines each invented their own layout
    (`SCRATCH-LeidenMetaprogram/`, `SCRATCH_NMF-prep/`, `data/<task.process>/`,
    `<project>/cellcommunication/report/`), which is why cross-stage reporting
    was not previously possible.
----------------------------------------------------------------------------------------
*/

// Standard three-way publish block used by every notebook-rendering process.
//

process {

    /* =====================================================================
       PUBLISHING
       ---------------------------------------------------------------------
       Previously a top-level "def publishStage(stage)" helper called from 38
       withName blocks. Nextflow 26.x's strict config parser rejects function
       declarations in config, so the same layout is expressed once here and
       each process tags itself with ext.stage. Closures inside publishDir
       paths are standard and resolve at task time.

       A withName block with its own publishDir still overrides this.
       ===================================================================== */
    publishDir = [
        [ path: { "${params.outdir}/${params.project_name}/${task.ext.stage ?: task.process.tokenize(":").last().toLowerCase()}/report" },
          pattern: 'report/*.html', mode: params.publish_mode, overwrite: true,
          saveAs: { f -> f.tokenize('/').last() } ],
        [ path: { "${params.outdir}/${params.project_name}/${task.ext.stage ?: task.process.tokenize(":").last().toLowerCase()}/data" },
          pattern: 'data/**', mode: params.publish_mode, overwrite: true,
          saveAs: { f -> f.replaceFirst('^data/', '') } ],
        [ path: { "${params.outdir}/${params.project_name}/${task.ext.stage ?: task.process.tokenize(":").last().toLowerCase()}/figures" },
          pattern: 'figures/**', mode: params.publish_mode, overwrite: true,
          saveAs: { f -> f.replaceFirst('^figures/', '') } ],
        [ path: { "${params.outdir}/${params.project_name}/${task.ext.stage ?: task.process.tokenize(":").last().toLowerCase()}/figures" },
          pattern: '_freeze/**/figure-html/*.png', mode: params.publish_mode, overwrite: true,
          saveAs: { f -> f.endsWith('.png') ? f.tokenize('/').last() : null } ]
    ]

    /* =====================================================================
       ALIGN
       ===================================================================== */
    withName: 'SAMPLESHEET_CHECK' {
        publishDir = [[ path: { "${params.outdir}/pipeline_info" }, mode: params.publish_mode, overwrite: true ]]
    }

    withName: 'AUTO_DEMUX' {
        ext.args   = { [
            "--n-detect ${params.demux_n_detect}",
            "--min-freq ${params.demux_min_freq}",
            "--mismatches ${params.demux_mismatches}"
        ].join(' ') }
        publishDir = [[ path: "${params.outdir}/${params.project_name}/align/demux", pattern: 'demuxed/*.csv', mode: params.publish_mode, overwrite: true ]]
    }

    withName: 'CELLRANGER_COUNT|CELLRANGER_VDJ|CELLRANGER_MULTI|CELLRANGER_MKFASTQ' {
        publishDir = [[ path: { "${params.outdir}/${params.project_name}/align/${task.process.tokenize(':').last()}" }, mode: params.publish_mode, overwrite: true ]]
    }

    /* =====================================================================
       QC
       ===================================================================== */
    withName: 'CELLBENDER' {
        ext.args = { [
            "--expected-cells ${params.cellbender_expected_cells}",
            "--total-droplets-included ${params.cellbender_total_droplets}",
            "--fpr ${params.cellbender_fpr}",
            "--epochs ${params.cellbender_epochs}"
        ].join(' ').trim() }
        ext.when   = { !params.skip_cellbender }
        publishDir = [[ path: { "${params.outdir}/${params.project_name}/qc/cellbender" }, mode: params.publish_mode, overwrite: true ]]
    }

    withName: 'SEURAT_QUALITY' {
        ext.args = { [
            "project_name:${params.project_name}",
            "thr_estimate_n_cells:${params.qc_thr_estimate_n_cells}",
            "thr_mean_reads_per_cells:${params.qc_thr_mean_reads_per_cells}",
            "thr_median_genes_per_cell:${params.qc_thr_median_genes_per_cell}",
            "thr_median_umi_per_cell:${params.qc_thr_median_umi_per_cell}",
            "thr_n_feature_rna_min:${params.qc_thr_n_feature_rna_min}",
            "thr_n_feature_rna_max:${params.qc_thr_n_feature_rna_max}",
            "thr_percent_mito:${params.qc_thr_percent_mito}",
            "thr_n_observed_cells:${params.qc_thr_n_observed_cells}",
            "work_directory:\$PWD"
        ].join(' -P ').trim() }
        publishDir = [[ path: { "${params.outdir}/${params.project_name}/qc/per_sample" }, mode: params.publish_mode, overwrite: true ]]
    }

    withName: 'HELPER_SUMMARIZE' {
        ext.args   = { [ "project_name:${params.project_name}", "work_directory:\$PWD" ].join(' -P ').trim() }
        ext.stage   = 'qc'
    }

    withName: 'SEURAT_MERGE' {
        ext.args   = { [ "project_name:${params.project_name}", "work_directory:\$PWD" ].join(' -P ').trim() }
        ext.stage   = 'qc'
    }

    withName: 'SCDBLFINDER' {
        ext.args   = { [ "project_name:${params.project_name}", "work_directory:\$PWD" ].join(' -P ').trim() }
        ext.when   = { !params.skip_scdblfinder }
        ext.stage   = 'qc'
    }

    /* =====================================================================
       CLUSTER
       ===================================================================== */
    withName: 'SEURAT_NORMALIZE' {
        ext.args = { [
            "project_name:${params.project_name}",
            "thr_n_features:${params.cluster_thr_n_features}",
            "thr_n_dimensions:${params.cluster_thr_n_dimensions}",
            "work_directory:\$PWD"
        ].join(' -P ').trim() }
        ext.stage   = 'cluster'
    }

    withName: 'SEURAT_CLUSTER' {
        // NOTE: the source pipeline read `paramas.input_integration_dimension`
        // (typo) here, which made this process fail at config-evaluation time.
        ext.args = { [
            "project_name:${params.project_name}",
            "input_integration_dimension:${params.cluster_integration_dimension}",
            "input_group_plot:'${params.cluster_group_plot}'",
            "thr_resolution:${params.cluster_thr_resolution}",
            "thr_proportion:${params.cluster_thr_proportion}",
            "work_directory:\$PWD"
        ].join(' -P ').trim() }
        ext.stage   = 'cluster'
    }

    /* =====================================================================
       ANNOTATION
       ===================================================================== */
    withName: 'HELPER_SEURAT_SUBSET|HELPER_SCEASY_CONVERTER.*' {
        publishDir = [[ path: "${params.outdir}/${params.project_name}/annotation/data", mode: params.publish_mode, overwrite: true ]]
    }

    withName: 'CELLTYPIST_ANNOTATION' {
        ext.args   = { [ "project_name:${params.project_name}", "organism:${params.organism_capitalised}", "work_directory:\$PWD" ].join(' -P ').trim() }
        ext.when   = { !params.skip_celltypist }
        ext.stage   = 'annotation'
    }

    withName: 'SCYTPE_MAJOR_ANNOTATION' {
        ext.args = { [
            "project_name:${params.project_name}",
            "input_n_features:${params.annot_thr_n_features}",
            "work_directory:\$PWD"
        ].join(' -P ').trim() }
        ext.when   = { !params.skip_sctype }
        ext.stage   = 'annotation'
    }

    // Split from a shared 'STATE|AGGREGATE' selector. quarto aborts on any -P key
    // the notebook does not declare, and these two declare DIFFERENT params:
    // STATE takes the thr_* clustering thresholds, AGGREGATE takes none of them.
    // The shared block also passed `organism`, which NEITHER declares or uses --
    // that is what killed the T_Cells state task on a real run.
    withName: 'SCYTPE_STATE_ANNOTATION' {
        ext.args = { [
            "project_name:${params.project_name}",
            "thr_n_features:${params.annot_thr_n_features}",
            "thr_npc:${params.annot_thr_npc}",
            "thr_resolution:${params.annot_thr_resolution}",
            "work_directory:\$PWD"
        ].join(' -P ').trim() }
        ext.when   = { !params.skip_sctype }
        ext.stage   = 'annotation'
    }

    withName: 'SCYTPE_AGGREGATE_ANNOTATION' {
        ext.args = { [
            "project_name:${params.project_name}",
            "work_directory:\$PWD"
        ].join(' -P ').trim() }
        ext.when   = { !params.skip_sctype }
        ext.stage   = 'annotation'
    }

    withName: 'AZIMUTH_ANNOTATION' {
        ext.args   = { [ "project_name:${params.project_name}", "work_directory:\$PWD" ].join(' -P ').trim() }
        ext.when   = { !params.skip_azimuth }
        ext.stage   = 'annotation'
    }

    withName: 'ANNOTATION_CONCORDANCE' {
        ext.args   = { [ "project_name:${params.project_name}",
                         "work_directory:\$PWD",
                         "min_pair_cells:${params.concordance_min_pair_cells}" ].join(' -P ').trim() }
        ext.when   = { !params.skip_annotation_concordance }
        ext.stage  = 'annotation'
    }

    /* METATIME_ANNOTATION, GENEVECTOR_ANNOTATION and QUARTO_RENDER_PROJECT are
       defined as modules but are not included by any subworkflow, so their
       selectors matched nothing and Nextflow warned on every single run. The
       modules are left in place; wire them into a subworkflow and restore a
       selector here at that point. Same reason CELLRANGER_MKFASTQ's container
       selector was dropped from conf/containers.config. */

    /* =====================================================================
       BATCH CORRECTION
       ===================================================================== */
    withName: 'BATCHCORRECTION' {
        ext.when   = { !params.skip_batchcorrect }
        ext.stage   = 'batchcorrection'
    }

    /* =====================================================================
       CNV
       ===================================================================== */
    withName: 'INFERCNV' {
        ext.args = { [
            "project_name:${params.project_name}",
            "organism:${params.organism_lower}",
            "input_analysis_mode:${params.cnv_analysis_mode}",
            "bayes_max_p_normal:${params.cnv_infercnv_bayes_max_p_normal}",
            "work_directory:\$PWD"
        ].join(' -P ').trim() }
        ext.when   = { !params.skip_infercnv }
        ext.stage   = 'cnv'
    }

    withName: 'CNV_CONCORDANCE' {
        ext.args = { [ "project_name:${params.project_name}",
                       "celltype_col:${params.celltype_col}",
                       "sample_col:${params.tme_sample_col}",
                       // QUOTED, like the STRATIFY block below. The value contains
                       // semicolons ("T_Cells;NK_Cells;..."), and an unquoted `;` in
                       // the rendered .command.sh is a SHELL COMMAND SEPARATOR — the
                       // task died with `NK_Cells: command not found` after quarto had
                       // already rendered the report, so it looked like a render failure.
                       "reference_labels:'${params.stratify_reference_labels}'",
                       "infercnv_sd_threshold:${params.stratify_infercnv_sd}",
                       "caller_inputs:caller_inputs",
                       "work_directory:\$PWD" ].join(' -P ').trim() }
        ext.when   = { !params.skip_cnv_concordance }
        ext.stage  = 'cnv'
    }

    withName: 'COPYKAT_PROCESS' {
        ext.args   = { [ "project_name:${params.project_name}", "input_model:${params.organism_lower}", "workdir:\$PWD" ].join(' -P ').trim() }
        ext.when   = { !params.skip_copykat }
        ext.stage   = 'cnv'
    }

    /* =====================================================================
       NUMBAT (opt-in)
       ===================================================================== */
    withName: 'NUMBAT_PREP|NUMBAT_PILEUP' {
        publishDir = []   // intermediates: published nothing before, keep it that way
        ext.when = { params.run_numbat }
    }
    withName: 'NUMBAT_RUN' {
        ext.when   = { params.run_numbat }
        publishDir = [
            [ path: "${params.outdir}/${params.project_name}/cnv/numbat", pattern: 'numbat/**', mode: params.publish_mode, overwrite: true, saveAs: { f -> f.replaceFirst('^numbat/', '') } ],
            [ path: "${params.outdir}/${params.project_name}/cnv/figures", pattern: 'figures/numbat/**', mode: params.publish_mode, overwrite: true, saveAs: { f -> f.tokenize('/').last() } ]
        ]
    }

    /* =====================================================================
       STRATIFY
       ===================================================================== */
    withName: 'STRATIFY_COMPARTMENTS' {
        ext.args = { [
            "method:${params.stratify_method}",
            "min_callers:${params.stratify_min_callers}",
            "tumor_labels:'${params.stratify_tumor_labels}'",
            "reference_labels:'${params.stratify_reference_labels}'",
            "celltype_col:${params.tme_celltype_col ?: params.celltype_col}",
            "sample_col:${params.tme_sample_col}",
            "infercnv_sd_threshold:${params.stratify_infercnv_sd}",
            "gate_by_lineage:${params.stratify_gate_by_lineage}",
            "caller_priority:${params.cnv_caller_priority}",
            "ambiguous:${params.stratify_ambiguous}",
            "min_cells_per_compartment:${params.stratify_min_cells}",
            "seed:${params.seed}"
        ].join(' -P ').trim() }
        ext.when   = { params.run_stratify == null || params.run_stratify }
        ext.stage   = 'stratify'
    }

    /* =====================================================================
       TME CHARACTERISATION
       ===================================================================== */
    withName: 'TME_CHARACTERISATION' {
        ext.args = { [
            "celltype_col:${params.tme_celltype_col ?: params.celltype_col}",
            "sample_col:${params.tme_sample_col}",
            "condition_col:${params.tme_condition_col}",
            "patient_col:${params.tme_patient_col}",
            "min_cells_per_group:${params.tme_min_cells_per_group}",
            "top_n_celltypes:${params.tme_top_n_celltypes}",
            "seed:${params.seed}"
        ].join(' -P ').trim() }
        ext.when   = { !params.skip_tme }
        ext.stage   = 'tme'
    }

    /* =====================================================================
       TUMOUR HETEROGENEITY / METAPROGRAMS
       ===================================================================== */
    withName: 'METAPROG_LEIDEN' {
        ext.args = { [
            "subset_col:${params.metaprog_subset_col}",
            "subset_values:'${params.metaprog_subset_values}'",
            "min_cells_per_sample_epith:${params.metaprog_min_cells_per_sample}",
            "complexity_filter:${params.metaprog_complexity_filter}",
            "mito_filter:${params.metaprog_mito_filter}",
            "hvg_keep:${params.metaprog_hvg_keep}",
            "dims_use_max:${params.metaprog_dims_use_max}",
            "resolution:${params.metaprog_resolution}",
            "genes_per_program:${params.metaprog_genes_per_program}",
            "sig_th:${params.metaprog_sig_th}",
            "seed:${params.seed}"
        ].join(' -P ').trim() }
        ext.stage   = 'metaprog'
    }

    withName: 'METAPROG_NMF_PREP' {
        ext.args = { [
            // METAPROG_LEIDEN receives these; NMF_PREP did not, so it fell back to
            // the notebook's default subset_col ("azimuth_labels") and aborted on
            // any object that does not carry that column. Both notebooks subset
            // the same way and must be told the same thing.
            "subset_col:${params.metaprog_subset_col}",
            "subset_values:'${params.metaprog_subset_values}'",
            "min_cells:${params.metaprog_min_cells}",
            "seed:${params.seed}"
        ].join(' -P ').trim() }
        ext.stage   = 'metaprog'
    }

    // R engine (NMF::nmf)
    withName: 'METAPROG_NMF' {
        ext.args = { [
            "rank_lb:${params.metaprog_rank_lb}",
            "rank_ub:${params.metaprog_rank_ub}",
            "nrun:${params.metaprog_nrun}",
            "nmf_method:${params.metaprog_nmf_method}",
            "hvg_keep:${params.metaprog_hvg_keep}",
            "min_cells:${params.metaprog_min_cells}",
            "max_cells:${params.metaprog_max_cells}",
            "seed:${params.seed}"
        ].join(' -P ').trim() }
        ext.when   = { params.metaprog_nmf_engine in ['r', 'both'] }
        ext.stage   = 'metaprog'
    }

    // Python engine (scanpy + scikit-learn)
    withName: 'METAPROG_NMF_PY' {
        ext.args = { [
            "--rank-lb ${params.metaprog_rank_lb}",
            "--rank-ub ${params.metaprog_rank_ub}",
            "--nrun ${params.metaprog_nrun}",
            "--hvg-keep ${params.metaprog_hvg_keep}",
            "--min-cells ${params.metaprog_min_cells}",
            "--max-cells ${params.metaprog_max_cells}",
            "--genes-per-program ${params.metaprog_genes_per_program}",
            "--init ${params.metaprog_py_init}",
            "--solver ${params.metaprog_py_solver}",
            "--beta-loss ${params.metaprog_py_beta_loss}",
            "--max-iter ${params.metaprog_py_max_iter}",
            "--tol ${params.metaprog_py_tol}",
            "--seed ${params.seed}"
        ].join(' ') }
        ext.when   = { params.metaprog_nmf_engine in ['python', 'both'] }
        ext.stage   = 'metaprog'
    }

    withName: 'METAPROG_POST' {
        ext.args = { [
            "min_intersect_initial:${params.metaprog_min_intersect_initial}",
            "min_intersect_cluster:${params.metaprog_min_intersect_cluster}",
            "min_group_size:${params.metaprog_min_group_size}",
            "intra_min:${params.metaprog_intra_min}",
            "intra_max:${params.metaprog_intra_max}",
            "inter_min:${params.metaprog_inter_min}",
            "genes_per_program:${params.metaprog_genes_per_program}",
            "nmf_engine:${params.metaprog_nmf_engine}",
            "seed:${params.seed}"
        ].join(' -P ').trim() }
        ext.stage   = 'metaprog'
    }

    /* =====================================================================
       TRAJECTORY
       ===================================================================== */
    withName: 'CELLTRAJECTORY' {
        ext.args   = { [ "project_name:${params.project_name}", "ct_species:${params.traj_species}", "seed:${params.seed}", "work_directory:\$PWD" ].join(' -P ').trim() }
        ext.when   = { !params.skip_trajectory }
        ext.stage   = 'trajectory'
    }

    /* =====================================================================
       CELL COMMUNICATION
       ===================================================================== */
    withName: 'CELLCOMM_LIANA' {
        ext.args = { [
            "project_name:${params.project_name}",
            "assay:${params.cc_assay}", "slot:${params.cc_slot}",
            "celltype_col:${params.cc_celltype_col ?: params.celltype_col}",
            "sample_col:${params.cc_sample_col}",
            "min_cells_per_group:${params.cc_min_cells_per_group}",
            "liana_resource:${params.cc_liana_resource}",
            "liana_top_n_plot:${params.cc_liana_top_n_plot}"
        ].join(' -P ').trim() }
        ext.stage   = 'cellcomm'
        ext.when   = { !params.skip_liana }
    }

    withName: 'CELLCOMM_CELLCHAT' {
        ext.args = { [
            "project_name:${params.project_name}",
            "organism:${params.organism_lower}",
            "assay:${params.cc_assay}", "slot:${params.cc_slot}",
            "celltype_col:${params.cc_celltype_col ?: params.celltype_col}",
            "min_cells_per_group:${params.cc_min_cells_per_group}"
        ].join(' -P ').trim() }
        ext.stage   = 'cellcomm'
        ext.when   = { !params.skip_cellchat }
    }

    withName: 'CELLCOMM_NICHENET' {
        ext.args = { [
            "project_name:${params.project_name}",
            "celltype_col:${params.cc_celltype_col ?: params.celltype_col}",
            "condition_col:${params.cc_condition_col}",
            "receiver_mode:${params.cc_receiver_mode}",
            "sender_mode:${params.cc_sender_mode}",
            "auto_k_receivers:${params.cc_auto_k_receivers}",
            "auto_m_senders:${params.cc_auto_m_senders}",
            "manual_receivers:'${params.cc_manual_receivers}'",
            "manual_senders:'${params.cc_manual_senders}'",
            "condition_ref:${params.cc_condition_ref}",
            "condition_test:${params.cc_condition_test}",
            "logfc_min:${params.cc_logfc_min}",
            "padj_max:${params.cc_padj_max}",
            "max_geneset:${params.cc_max_geneset}",
            "top_ligands:${params.cc_top_ligands}",
            "heatmap_ligands:${params.cc_heatmap_ligands}",
            "heatmap_targets_per_ligand:${params.cc_heatmap_targets_per_ligand}"
        ].join(' -P ').trim() }
        ext.stage   = 'cellcomm'
        ext.when   = { !params.skip_nichenet }
    }

    /* =====================================================================
       TCR
       ===================================================================== */
    withName: 'VDJ_QC' {
        ext.when   = { params.tcr_run_vdj_qc }
        ext.stage   = 'tcr/vdj_qc'
    }
    withName: 'TCELL_INTEGRATION' {
        ext.stage   = 'tcr/integration'
    }
    withName: 'TCRI'      { ext.when = { params.tcr_run_tcri     }; ext.stage   = 'tcr/tcri'       }
    withName: 'CONGA'     { ext.when = { params.tcr_run_conga    }; ext.stage   = 'tcr/conga'      }
    withName: 'GLIPH2'    { ext.when = { params.tcr_run_gliph2   }; ext.stage   = 'tcr/gliph2'     }
    withName: 'TCRDIST3'  { ext.when = { params.tcr_run_tcrdist3 }; ext.stage   = 'tcr/tcrdist3'   }
    withName: 'GIANA'     { ext.when = { params.tcr_run_giana    }; ext.stage   = 'tcr/giana'      }
    withName: 'REPERTOIRE'{ ext.when = { params.tcr_run_repertoire }; ext.stage   = 'tcr/repertoire' }
    withName: 'CONSENSUS_CLUSTERING' { ext.when = { params.tcr_run_consensus }; ext.stage   = 'tcr/consensus' }
    withName: 'MASTER_SUMMARY'       { ext.when = { params.tcr_run_master_summary }; ext.stage   = 'tcr/summary' }

    /* =====================================================================
       PER-STAGE SMART REPORTS
       ===================================================================== */
    withName: 'STAGE_REPORT' {
        ext.when   = { params.stage_reports }
        publishDir = [
            [ path: { "${params.outdir}/${params.project_name}/${stage}/report" },
              pattern: 'report/*.html', mode: params.publish_mode, overwrite: true,
              saveAs: { f -> f.tokenize('/').last() } ],
            [ path: { "${params.outdir}/${params.project_name}/${stage}/data" },
              pattern: 'data/findings.json', mode: params.publish_mode, overwrite: true,
              saveAs: { f -> f.tokenize('/').last() } ]
        ]
    }

    /* =====================================================================
       CROSS-STAGE INTEGRATION
       ===================================================================== */
    withName: 'INTEGRATE_OBJECTS' {
        ext.when   = { params.integration_build_master_object }
        ext.stage   = 'integration'
    }

    withName: 'CROSS_ANALYSIS' {
        ext.args = { [
            "project_name:${params.project_name}",
            "celltype_col:${params.cc_celltype_col ?: params.celltype_col}",
            "sample_col:${params.cc_sample_col}",
            "condition_col:${params.cc_condition_col}",
            "interactive:${params.report_interactive}",
            "seed:${params.seed}"
        ].join(' -P ').trim() }
        ext.when   = { params.integration_cross_analysis }
        ext.stage   = 'integration'
    }

    withName: 'RUN_MANIFEST' {
        publishDir = [[ path: { "${params.outdir}/${params.project_name}/integration" }, mode: params.publish_mode, overwrite: true ]]
    }

    withName: 'MASTER_REPORT' {
        ext.when   = { params.integration_master_report }
        // The master report is the pipeline's front door: publish at the root.
        publishDir = [
            [ path: { "${params.outdir}/${params.project_name}" }, pattern: 'master_report/**', mode: params.publish_mode, overwrite: true ],
            // index.html and the rendered site live under report/; publish them
            // INTO master_report/ so the banner's path actually resolves.
            [ path: { "${params.outdir}/${params.project_name}/master_report" }, pattern: 'report/**', saveAs: { it.replaceFirst('^report/', '') }, mode: params.publish_mode, overwrite: true ]
        ]
    }
}
